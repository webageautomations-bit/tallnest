---
// Jingo zone header — lightweight, sticky, candy-pop. Desktop shows the nav
// inline; mobile uses a native popover menu (works without JS, light-dismiss
// and Esc built in). The JingoFooter repeats every link as a further fallback.
import { Image } from "astro:assets";
import logoRed from "../../assets/jingo/jingo-logo-red.png";
// Parent brand: the deep-red Tall Nest logo reads on the cream header bar.
import tallNestLogo from "../../assets/tallnest/tallnest-logo.png";

const CATALOGUE = "/jingo-catalogue-2026.pdf";
const downloadIcon = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11"/><path d="m7 10.5 5 5 5-5"/><path d="M5 20h14"/></svg>`;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const onHub = path === "/jingo";

const links = [
  { label: "Home", href: "/jingo", current: onHub },
  { label: "Flavours", href: "/jingo/flavours", current: path.startsWith("/jingo/flavours") },
  { label: "Mascots", href: "/jingo/mascots", current: path.startsWith("/jingo/mascots") },
  // On-page anchor for now; resolves from any Jingo page.
  { label: "Our Story", href: onHub ? "#story" : "/jingo#story", current: false },
];
---

<header id="jingo-header" class="jh">
  <div class="jg-wrap jh-row">
    <!-- Jingo — the zone's primary brand, far left. -->
    <a href="/jingo" class="jh-logo" aria-label="Jingo — home">
      <Image
        src={logoRed}
        alt="Jingo"
        width={180}
        class="jh-logo-img"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav aria-label="Jingo" class="jh-nav">
      <ul>
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={["jh-link", { "is-current": l.current }]}
                aria-current={l.current ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="jh-end">
      <a
        href={CATALOGUE}
        download
        class="jh-dl"
        aria-label="Download Jingo catalogue (PDF)"
      >
        <span class="jh-dl-icon" set:html={downloadIcon} />
        <span><span class="jh-dl-verb">Download </span>Catalogue</span>
      </a>
      <!-- "Part of Tall Nest" mark, pinned far right (desktop). On narrow
           widths it lives in the mobile menu instead. -->
      <span class="jh-divider" aria-hidden="true"></span>
      <a href="/" class="jh-parent" aria-label="Tall Nest home">
        <Image
          src={tallNestLogo}
          alt="Tall Nest"
          width={160}
          class="jh-parent-img"
          loading="eager"
        />
      </a>
      <button
        type="button"
        class="jh-menu-btn"
        popovertarget="jingo-menu"
        aria-label="Open menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu (native popover — top layer, no JS required). -->
<div id="jingo-menu" popover class="jm" aria-label="Jingo menu">
  <div class="jm-head">
    <span class="jm-title">Menu</span>
    <button
      type="button"
      class="jh-menu-btn jm-close"
      popovertarget="jingo-menu"
      popovertargetaction="hide"
      aria-label="Close menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <ul class="jm-list">
    {
      links.map((l, i) => (
        <li>
          <a
            href={l.href}
            class:list={["jm-link", { "is-current": l.current }]}
            aria-current={l.current ? "page" : undefined}
            style={`--i:${i}`}
          >
            {l.label}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))
    }
  </ul>
  <a
    href={CATALOGUE}
    download
    class="jm-dl"
    aria-label="Download Jingo catalogue (PDF)"
  >
    <span class="jh-dl-icon" set:html={downloadIcon} />
    Download Catalogue
  </a>
  <a href="/" class="jm-parent" aria-label="Tall Nest home">
    <Image src={tallNestLogo} alt="Tall Nest" width={160} class="jm-parent-img" loading="lazy" />
  </a>
</div>

<style>
  .jh {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--jg-cream) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 2.5px solid transparent;
    transition: border-color 0.2s ease;
  }
  .jh.is-scrolled {
    border-bottom-color: var(--jg-ink);
  }
  .jh-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }
  /* "Part of Tall Nest" mark — far right on desktop (hidden on narrow widths,
     where the mobile menu carries it). */
  .jh-parent {
    display: none;
    align-items: center;
    min-height: 44px; /* tap target */
    padding-inline: 2px;
    border-radius: 10px;
    -webkit-tap-highlight-color: transparent;
    transition: opacity 0.2s ease, transform 0.25s var(--jg-ease);
  }
  .jh-parent-img {
    height: 30px;
    width: auto;
  }
  @media (hover: hover) {
    .jh-parent:hover {
      transform: translateY(-1px);
      opacity: 0.85;
    }
  }
  .jh-divider {
    display: none;
    width: 2px;
    height: 30px;
    margin-inline: 6px 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--jg-ink) 25%, transparent);
  }
  .jh-logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* tap target */
    border-radius: 12px;
    -webkit-tap-highlight-color: transparent;
  }
  .jh-logo-img {
    height: 42px;
    width: auto;
    transition: transform 0.3s var(--jg-ease);
  }
  @media (hover: hover) {
    .jh-logo:hover .jh-logo-img {
      transform: rotate(-4deg) scale(1.05);
    }
  }

  /* Desktop nav */
  .jh-nav {
    display: none;
  }
  .jh-nav ul {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .jh-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid transparent;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--jg-ink);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.25s var(--jg-ease);
  }
  @media (hover: hover) {
    .jh-link:hover {
      background: var(--jg-bubble);
      transform: rotate(-2deg);
    }
  }
  .jh-link.is-current {
    background: var(--jg-sun);
    border-color: var(--jg-ink);
  }

  .jh-end {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* Download Catalogue — candy-pop red pill, compact so it doesn't out-shout
     the nav. Desktop only in the bar; the mobile menu has a full-width one. */
  .jh-dl {
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px 0 13px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 999px;
    background: var(--jg-red);
    color: var(--jg-white);
    box-shadow: 0 3px 0 var(--jg-ink);
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.25s var(--jg-ease),
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }
  .jh-dl-icon {
    display: inline-flex;
  }
  @media (hover: hover) {
    .jh-dl:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 0 var(--jg-ink);
    }
    .jh-dl:hover :global(svg) {
      animation: jh-dl-nudge 0.6s var(--jg-ease);
    }
  }
  .jh-dl:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 var(--jg-ink);
  }
  @keyframes jh-dl-nudge {
    40% {
      transform: translateY(3px);
    }
  }
  .jh-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 2.5px solid var(--jg-ink);
    background: var(--jg-sun);
    color: var(--jg-ink);
    box-shadow: 0 3px 0 var(--jg-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .jh-menu-btn:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 var(--jg-ink);
  }

  @media (min-width: 900px) {
    .jh-nav {
      display: block;
    }
    .jh-menu-btn {
      display: none;
    }
    .jh-dl {
      display: inline-flex;
    }
    .jh-divider {
      display: block;
    }
    .jh-parent {
      display: inline-flex;
    }
  }

  /* Mobile menu sheet (popover). */
  .jm {
    position: fixed;
    inset: 10px 10px auto 10px;
    width: auto;
    max-width: 520px;
    margin: 0 0 0 auto;
    padding: 18px 18px 22px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 28px;
    background: var(--jg-cream);
    color: var(--jg-ink);
    box-shadow: 0 8px 0 var(--jg-ink);
  }
  .jm::backdrop {
    background: rgba(36, 18, 26, 0.45);
  }
  .jm-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .jm-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--jg-ink-soft);
    padding-inline-start: 6px;
  }
  .jm-close {
    display: inline-flex;
  }
  .jm-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .jm-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    padding: 0 20px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 20px;
    background: var(--jg-paper);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--jg-ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .jm-list li:nth-child(4n + 1) .jm-link { background: var(--jg-sun); }
  .jm-list li:nth-child(4n + 2) .jm-link { background: var(--jg-pink); }
  .jm-list li:nth-child(4n + 3) .jm-link { background: var(--jg-sky); }
  .jm-list li:nth-child(4n + 4) .jm-link { background: var(--jg-lime); }
  .jm-link:active {
    transform: scale(0.98);
  }
  .jm-link.is-current {
    box-shadow: inset 0 0 0 3px var(--jg-paper);
  }
  /* Menu: full-width download button + Tall Nest logo (back to parent). */
  .jm-dl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 56px;
    margin-top: 14px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 20px;
    background: var(--jg-red);
    color: var(--jg-white);
    box-shadow: 0 4px 0 var(--jg-ink);
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .jm-dl:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--jg-ink);
  }
  .jm-parent {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 14px;
    padding: 0 6px;
    border-radius: 10px;
  }
  .jm-parent-img {
    height: 30px;
    width: auto;
  }

  /* 900–1099px: icon + "Catalogue" only, so the bar never crowds the nav
     (the accessible name stays "Download Jingo catalogue (PDF)"). */
  @media (min-width: 900px) and (max-width: 1099px) {
    .jh-dl-verb {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jh-logo-img,
    .jh-link,
    .jh-parent,
    .jh-dl {
      transition: none;
    }
    .jh-dl:hover :global(svg) {
      animation: none;
    }
  }
</style>

<script>
  const header = document.getElementById("jingo-header");
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
  // Same-page anchors (e.g. "Our Story") are intercepted by smooth scroll, so
  // close the popover explicitly when any menu link is tapped.
  const menu = document.getElementById("jingo-menu") as
    | (HTMLElement & { hidePopover?: () => void })
    | null;
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      try {
        menu.hidePopover?.();
      } catch {
        /* already hidden */
      }
    }),
  );
</script>
