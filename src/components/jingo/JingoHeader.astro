---
// Jingo zone header — lightweight, sticky, candy-pop. Desktop shows the nav
// inline; mobile uses a native popover menu (works without JS, light-dismiss
// and Esc built in). The JingoFooter repeats every link as a further fallback.
import { Image } from "astro:assets";
import logoRed from "../../assets/jingo/jingo-logo-red.png";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const onHub = path === "/jingo";

const links = [
  { label: "Home", href: "/jingo", current: onHub },
  { label: "Flavours", href: "/jingo/flavours", current: path.startsWith("/jingo/flavours") },
  { label: "Mascots", href: "/jingo/mascots", current: path.startsWith("/jingo/mascots") },
  // On-page anchor for now; resolves from any Jingo page.
  { label: "Our Story", href: onHub ? "#story" : "/jingo#story", current: false },
];
---

<header id="jingo-header" class="jh">
  <div class="jg-wrap jh-row">
    <a href="/jingo" class="jh-logo" aria-label="Jingo — home">
      <Image
        src={logoRed}
        alt="Jingo"
        width={180}
        class="jh-logo-img"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav aria-label="Jingo" class="jh-nav">
      <ul>
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={["jh-link", { "is-current": l.current }]}
                aria-current={l.current ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="jh-end">
      <a href="/" class="jh-back">
        <span aria-hidden="true">&larr;</span> Tall Nest
      </a>
      <button
        type="button"
        class="jh-menu-btn"
        popovertarget="jingo-menu"
        aria-label="Open menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu (native popover — top layer, no JS required). -->
<div id="jingo-menu" popover class="jm" aria-label="Jingo menu">
  <div class="jm-head">
    <span class="jm-title">Menu</span>
    <button
      type="button"
      class="jh-menu-btn jm-close"
      popovertarget="jingo-menu"
      popovertargetaction="hide"
      aria-label="Close menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <ul class="jm-list">
    {
      links.map((l, i) => (
        <li>
          <a
            href={l.href}
            class:list={["jm-link", { "is-current": l.current }]}
            aria-current={l.current ? "page" : undefined}
            style={`--i:${i}`}
          >
            {l.label}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))
    }
  </ul>
  <a href="/" class="jm-back">
    <span aria-hidden="true">&larr;</span> Back to Tall Nest
  </a>
</div>

<style>
  .jh {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--jg-cream) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 2.5px solid transparent;
    transition: border-color 0.2s ease;
  }
  .jh.is-scrolled {
    border-bottom-color: var(--jg-ink);
  }
  .jh-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }
  .jh-logo {
    display: inline-flex;
    border-radius: 12px;
    -webkit-tap-highlight-color: transparent;
  }
  .jh-logo-img {
    height: 42px;
    width: auto;
    transition: transform 0.3s var(--jg-ease);
  }
  @media (hover: hover) {
    .jh-logo:hover .jh-logo-img {
      transform: rotate(-4deg) scale(1.05);
    }
  }

  /* Desktop nav */
  .jh-nav {
    display: none;
  }
  .jh-nav ul {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .jh-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid transparent;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--jg-ink);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.25s var(--jg-ease);
  }
  @media (hover: hover) {
    .jh-link:hover {
      background: var(--jg-bubble);
      transform: rotate(-2deg);
    }
  }
  .jh-link.is-current {
    background: var(--jg-sun);
    border-color: var(--jg-ink);
  }

  .jh-end {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .jh-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--jg-ink-soft);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .jh-back:hover {
    color: var(--jg-ink);
    background: color-mix(in srgb, var(--jg-ink) 7%, transparent);
  }
  .jh-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 2.5px solid var(--jg-ink);
    background: var(--jg-sun);
    color: var(--jg-ink);
    box-shadow: 0 3px 0 var(--jg-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .jh-menu-btn:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 var(--jg-ink);
  }

  /* Mobile: hide the small back link next to the menu below 420px (it lives
     in the menu sheet too). */
  @media (max-width: 419px) {
    .jh-back {
      display: none;
    }
  }
  @media (min-width: 900px) {
    .jh-nav {
      display: block;
    }
    .jh-menu-btn {
      display: none;
    }
  }

  /* Mobile menu sheet (popover). */
  .jm {
    position: fixed;
    inset: 10px 10px auto 10px;
    width: auto;
    max-width: 520px;
    margin: 0 0 0 auto;
    padding: 18px 18px 22px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 28px;
    background: var(--jg-cream);
    color: var(--jg-ink);
    box-shadow: 0 8px 0 var(--jg-ink);
  }
  .jm::backdrop {
    background: rgba(36, 18, 26, 0.45);
  }
  .jm-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .jm-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--jg-ink-soft);
    padding-inline-start: 6px;
  }
  .jm-close {
    display: inline-flex;
  }
  .jm-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .jm-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    padding: 0 20px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 20px;
    background: var(--jg-paper);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--jg-ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .jm-list li:nth-child(4n + 1) .jm-link { background: var(--jg-sun); }
  .jm-list li:nth-child(4n + 2) .jm-link { background: var(--jg-pink); }
  .jm-list li:nth-child(4n + 3) .jm-link { background: var(--jg-sky); }
  .jm-list li:nth-child(4n + 4) .jm-link { background: var(--jg-lime); }
  .jm-link:active {
    transform: scale(0.98);
  }
  .jm-link.is-current {
    box-shadow: inset 0 0 0 3px var(--jg-paper);
  }
  .jm-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    margin-top: 12px;
    padding: 0 8px;
    font-weight: 600;
    color: var(--jg-ink);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .jh-logo-img,
    .jh-link {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById("jingo-header");
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
  // Same-page anchors (e.g. "Our Story") are intercepted by smooth scroll, so
  // close the popover explicitly when any menu link is tapped.
  const menu = document.getElementById("jingo-menu") as
    | (HTMLElement & { hidePopover?: () => void })
    | null;
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      try {
        menu.hidePopover?.();
      } catch {
        /* already hidden */
      }
    }),
  );
</script>
