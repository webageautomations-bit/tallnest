---
// Stats — three sticker blobs. Counts come from the data file; the count-up
// (scripts/count-up.ts, same mechanism as the corporate Flagship) animates
// toward the server-rendered final value.
import { categories, products, priceRange } from "../../lib/jingo";

const stats = [
  { value: `${categories.length}`, count: categories.length, suffix: "", label: "Categories", tone: "sun" },
  { value: `${products.length}+`, count: products.length, suffix: "+", label: "Products", tone: "pink" },
  { value: priceRange().label, count: null, suffix: "", label: "Pocket-money prices", tone: "sky" },
];
---

<section class="stats" aria-label="Jingo at a glance">
  <div class="jg-wrap">
    <ul data-reveal-group class="grid">
      {
        stats.map((s) => (
          <li data-reveal-item class:list={["stat jg-sticker", `tone-${s.tone}`]}>
            <span
              class="n"
              dir="ltr"
              data-count={s.count ?? undefined}
              data-suffix={s.suffix}
            >
              {s.value}
            </span>
            <span class="l">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: clamp(20px, 3.5vw, 32px);
    color: var(--jg-ink);
  }
  .stat:nth-child(3) {
    grid-column: 1 / -1;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .stat:nth-child(3) {
      grid-column: auto;
    }
  }
  .stat:nth-child(1) { rotate: -1.5deg; }
  .stat:nth-child(2) { rotate: 1deg; }
  .stat:nth-child(3) { rotate: -0.6deg; }
  .tone-sun { background: var(--jg-sun); }
  .tone-pink { background: var(--jg-pink); }
  .tone-sky { background: var(--jg-sky); }
  .n {
    font-size: clamp(2.6rem, 8vw, 4.6rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }
  .stat:nth-child(3) .n {
    font-size: clamp(2.1rem, 6vw, 3.6rem);
  }
  .l {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
