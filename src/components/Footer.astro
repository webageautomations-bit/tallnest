---
import { type Dict } from "../i18n/utils";

interface Props {
  t: Dict;
  // When true, the footer drops its rounded top + top border so it joins
  // seamlessly onto a dark section directly above it (e.g. the /about CTA).
  flush?: boolean;
}
const { t, flush = false } = Astro.props;

const navLinks = [
  { label: t.nav.about, href: "/about" },
  { label: t.nav.partners, href: "/partners" },
  { label: t.nav.theNest, href: "/the-nest" },
  { label: t.nav.media, href: "/media" },
  { label: t.nav.contact, href: "/contact" },
];

const phones = [
  { display: "+92 317 827 6277", href: "tel:+923178276277" },
];

const socials = [
  {
    label: "Facebook",
    href: "https://www.facebook.com/tallnestgroup",
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/tallnestgroup",
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg>`,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/company/tallnestgroup",
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v6h-4v-6a2 2 0 0 0-4 0v6h-4V8.5h4V10"/><rect x="2" y="9" width="4" height="11"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
];

const homeHref = "/";
---

<footer class:list={[flush ? "footer-flush" : "bg-white px-3 pt-[clamp(56px,8vw,96px)] sm:px-4 lg:px-6"]}>
  <div class:list={["footer-dark mx-auto max-w-7xl", { "is-flush": flush }]}>
    <div class="footer-inner">
      <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-12">
        <!-- Brand -->
        <div>
          <a href={homeHref} aria-label="Tall Nest — home" class="inline-flex">
            <img
              src="/tallnest-white.png"
              alt="Tall Nest Food &amp; Beverages"
              width="102"
              height="40"
              class="h-10 w-auto"
              decoding="async"
            />
          </a>
          <p class="mt-5 max-w-[34ch] text-sm leading-relaxed text-white/55">
            {t.footer.descriptor}
          </p>
          <ul class="mt-6 flex items-center gap-3">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.label}
                    class="social"
                    set:html={s.svg}
                  />
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Navigate -->
        <nav aria-label="Footer">
          <h2 class="foot-head">{t.footer.navHeading}</h2>
          <ul class="flex flex-col gap-2.5">
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} class="foot-link">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <!-- Contact -->
        <div>
          <h2 class="foot-head">{t.footer.contactHeading}</h2>
          <ul class="flex flex-col gap-2.5">
            {
              phones.map((p) => (
                <li>
                  <a href={p.href} dir="ltr" class="foot-link w-fit">
                    {p.display}
                  </a>
                </li>
              ))
            }
            <li>
              <a href="mailto:hello@tallnest.com" dir="ltr" class="foot-link w-fit">
                hello@tallnest.com
              </a>
            </li>
            <li class="text-sm text-white/55">{t.footer.address}</li>
          </ul>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="foot-bottom">
        <p>&copy; 2026 Tall Nest {t.footer.tagline}</p>
        <p>
          Website by{" "}
          <a
            href="https://webage.io"
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="webage-link">WebAge</a
          >
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-dark {
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
    border-radius: 36px 36px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  /* Flush variant: continue a dark section above with no seam. */
  .footer-dark.is-flush {
    border-radius: 0;
    border-top: 0;
  }
  /* Faint red radial glow for depth. */
  .footer-dark::before {
    content: "";
    position: absolute;
    top: -20%;
    inset-inline-start: -8%;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(224, 32, 43, 0.18), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .footer-inner {
    position: relative;
    padding: clamp(48px, 7vh, 88px) clamp(24px, 5vw, 72px) clamp(28px, 4vh, 40px);
  }
  .foot-head {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.68rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 18px;
  }
  .foot-link {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s var(--ease-brand);
  }
  .foot-link:hover {
    color: #fff;
  }
  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition:
      background 0.2s var(--ease-brand),
      border-color 0.2s var(--ease-brand),
      color 0.2s var(--ease-brand),
      transform 0.2s var(--ease-brand);
  }
  .social:hover {
    background: var(--color-red);
    border-color: var(--color-red);
    color: #fff;
    transform: translateY(-2px);
  }
  .foot-bottom {
    margin-top: clamp(40px, 6vh, 64px);
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    justify-content: space-between;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }
  /* Credit link — same muted tone as the bottom bar, subtle clickable hover. */
  .webage-link {
    color: rgba(255, 255, 255, 0.68);
    text-decoration: none;
    transition:
      color 0.2s var(--ease-brand),
      text-decoration-color 0.2s var(--ease-brand);
  }
  .webage-link:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .webage-link {
      transition: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .social,
    .foot-link {
      transition: none;
    }
  }
</style>
