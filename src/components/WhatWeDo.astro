---
// What we do — a connected three-step flow (Build → Market → Distribute).
import type { Dict } from "../i18n/utils";

interface Props {
  t: Dict["approach"];
}
const { t } = Astro.props;

const stepIcons = [
  // pencil (Build)
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>`,
  // megaphone (Market)
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
  // truck (Distribute)
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.3a1 1 0 0 0-.3-.7l-2.7-2.7a1 1 0 0 0-.7-.3H14v7h2"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="17.5" cy="17.5" r="1.5"/></svg>`,
];
---

<section id="approach" class="section-y bg-paper scroll-mt-24">
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <p data-reveal class="eyebrow mb-5">{t.eyebrow}</p>
    <h2
      data-reveal-heading
      class="max-w-2xl font-display text-[clamp(2rem,4vw,3.25rem)] font-medium leading-[1.05] tracking-[-0.02em] text-ink text-balance"
    >
      {t.heading}
    </h2>

    <div class="flow" data-flow>
      <span class="flow-line" aria-hidden="true"></span>
      <span class="flow-fill" aria-hidden="true"></span>
      <span class="flow-dot" aria-hidden="true"></span>
      <ol class="flow-grid">
        {
          t.steps.map((s, i) => (
            <li data-reveal-item class="step">
              <span class="node" aria-hidden="true" />
              <div class="step-head">
                <span class="step-num font-display">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="step-ic" aria-hidden="true" set:html={stepIcons[i]} />
              </div>
              <h3 class="mt-3 font-display text-2xl font-medium text-ink">
                {s.title}
              </h3>
              <p class="mt-2 max-w-[34ch] leading-relaxed text-gray">{s.line}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .flow {
    position: relative;
    margin-top: clamp(48px, 6vw, 72px);
  }
  /* Connector line — grows in via --grow (defaults to 1 with no JS). */
  .flow-line {
    position: absolute;
    top: 6px;
    inset-inline: 4px;
    height: 2px;
    background: var(--color-hairline);
    transform: scaleX(var(--grow, 1));
    transform-origin: left center;
    z-index: 0;
  }
  /* Red progress fill drawn over the hairline; grows left->right on scrub.
     Empty by default (no flash); reduced-motion shows it full. */
  .flow-fill {
    position: absolute;
    top: 6px;
    inset-inline-start: 4px;
    inset-inline-end: 4px;
    height: 2px;
    background: #93221e;
    transform: scaleX(0);
    transform-origin: left center;
    z-index: 0;
  }
  :global(html[dir="rtl"]) .flow-fill {
    transform-origin: right center;
  }
  /* One traveling dot riding the leading edge of the fill (shown by JS). */
  .flow-dot {
    position: absolute;
    top: 7px;
    inset-inline-start: 4px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #93221e;
    box-shadow:
      0 0 0 6px rgba(147, 34, 30, 0.12),
      0 0 16px 3px rgba(147, 34, 30, 0.28);
    opacity: 0;
    z-index: 2;
    pointer-events: none;
  }
  .flow-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    position: relative;
    padding-top: 34px;
  }
  .node {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--color-red);
    box-shadow: 0 0 0 5px var(--color-paper);
  }
  .step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .step-num {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 500;
    line-height: 1;
    color: var(--color-red);
  }
  .step-ic {
    color: var(--color-red);
    opacity: 0.85;
  }
  @media (max-width: 760px) {
    .flow-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .flow-line {
      top: 0;
      bottom: 0;
      inset-inline: auto;
      inset-inline-start: 6px;
      width: 2px;
      height: auto;
      transform: scaleY(var(--grow, 1));
      transform-origin: center top;
    }
    .step {
      padding-top: 0;
      padding-inline-start: 34px;
      padding-block: 20px;
    }
    .node {
      top: 24px;
    }
    /* Stacked layout has no traveling line. */
    .flow-fill,
    .flow-dot {
      display: none;
    }
  }
  /* Reduced motion / no animation: static final state — fill full, dot gone,
     nodes solid (default), columns visible (reveal-active never applied). */
  @media (prefers-reduced-motion: reduce) {
    .flow-fill {
      transform: scaleX(1);
    }
    .flow-dot {
      display: none;
    }
  }
</style>

<script>
  // Reuses the shared GSAP + ScrollTrigger instance (ESM singleton — registering
  // is idempotent, no second GSAP is added). Loaded only when motion is allowed.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const flow = document.querySelector<HTMLElement>("#approach .flow");
  const section = document.querySelector<HTMLElement>("#approach");

  if (flow && section && !reduce) void runFlow(flow, section);

  async function runFlow(flow: HTMLElement, section: HTMLElement) {
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import("gsap"),
      import("gsap/ScrollTrigger"),
    ]);
    gsap.registerPlugin(ScrollTrigger);
    const fill = flow.querySelector<HTMLElement>(".flow-fill")!;
    const dot = flow.querySelector<HTMLElement>(".flow-dot")!;
    const nodes = Array.from(flow.querySelectorAll<HTMLElement>(".node"));
    const steps = Array.from(flow.querySelectorAll<HTMLElement>(".step"));
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

    const mm = gsap.matchMedia();

    // Desktop / tablet (row layout): one scrubbed timeline — a traveling dot on
    // the leading edge of a growing red fill; each node snaps solid and its
    // column (number + title + copy) reveals as the dot arrives, in sequence.
    mm.add("(min-width: 761px)", () => {
      let trackW = 1;
      let fracs: number[] = [];

      const measure = () => {
        const fr = flow.getBoundingClientRect();
        const trackLeft = fr.left + 4;
        trackW = Math.max(1, fr.width - 8);
        fracs = nodes.map((n) => {
          const nr = n.getBoundingClientRect();
          return clamp((nr.left + nr.width / 2 - trackLeft) / trackW);
        });
      };

      const render = (p: number) => {
        gsap.set(fill, { scaleX: p });
        gsap.set(dot, { x: p * trackW });
        nodes.forEach((n, i) => {
          const arrive = clamp((p - (fracs[i] - 0.03)) / 0.06);
          gsap.set(n, { opacity: 0.25 + 0.75 * arrive });
        });
        steps.forEach((c, i) => {
          const ct = clamp((p - fracs[i]) / 0.14);
          const e = 1 - Math.pow(1 - ct, 2); // power2.out
          gsap.set(c, { opacity: e, y: 24 * (1 - e) });
        });
      };

      gsap.set(dot, { xPercent: -50, yPercent: -50, autoAlpha: 1 });
      measure();

      const st = ScrollTrigger.create({
        trigger: section,
        start: "top 80%",
        end: "top 30%",
        scrub: 1,
        invalidateOnRefresh: true,
        onRefresh: (self) => {
          measure();
          render(self.progress);
        },
        onUpdate: (self) => render(self.progress),
      });
      render(st.progress);

      return () => {
        st.kill();
        gsap.set([fill, dot, ...nodes, ...steps], { clearProps: "all" });
      };
    });

    // Mobile (stacked): no traveling line — a simple staggered fade-up.
    mm.add("(max-width: 760px)", () => {
      const t = gsap.fromTo(
        steps,
        { autoAlpha: 0, y: 20 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.5,
          ease: "power2.out",
          stagger: 0.12,
          scrollTrigger: { trigger: section, start: "top 78%" },
        },
      );
      return () => {
        t.scrollTrigger?.kill();
        t.kill();
        gsap.set(steps, { clearProps: "all" });
      };
    });
  }
</script>
