---
// Contact — split floating card: deep-red details panel + white "message us"
// panel. WhatsApp is the primary channel (general enquiry first, distributor
// enquiry second), with phone and email always visible alongside.
import type { Dict } from "../i18n/utils";
import WhatsAppCTA from "./WhatsAppCTA.astro";
import { PHONE_DISPLAY, PHONE_TEL, EMAIL } from "../data/contact";

interface Props {
  t: Dict["contact"];
}
const { t } = Astro.props;

const phones = [{ display: PHONE_DISPLAY, href: PHONE_TEL }];

const icons = {
  phone: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2z"/></svg>`,
  mail: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`,
  pin: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  globe: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/></svg>`,
};

const socials = [
  { label: "Facebook", href: "https://www.facebook.com/tallnestgroup", svg: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>` },
  { label: "Instagram", href: "https://www.instagram.com/tallnestgroup", svg: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg>` },
  { label: "LinkedIn", href: "https://www.linkedin.com/company/tallnestgroup", svg: `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v6h-4v-6a2 2 0 0 0-4 0v6h-4V8.5h4V10"/><rect x="2" y="9" width="4" height="11"/><circle cx="4" cy="4" r="2"/></svg>` },
];
---

<section id="contact" class="section-y bg-white">
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <div data-reveal class="contact-shell">
      <!-- Invitation panel -->
      <div class="cc-red on-dark">
        <div class="cc-blobs" data-blobs aria-hidden="true">
          <span class="cc-blob cc-blob-1"></span>
          <span class="cc-blob cc-blob-2"></span>
          <span class="cc-blob cc-blob-3"></span>
          <span class="cc-blob cc-blob-4"></span>
        </div>
        <p class="cc-eyebrow">{t.eyebrow}</p>
        <h2
          data-reveal-heading
          class="font-display text-[clamp(2rem,4vw,3rem)] font-medium leading-[1.05] tracking-[-0.02em]"
        >
          {t.heading}
        </h2>
        <p class="cc-invite">
          Whether you're a distributor, a retailer, or just curious — we'd love
          to hear from you.
        </p>

        <ul class="cc-list">
          <li>
            <span class="cc-ic" aria-hidden="true" set:html={icons.phone} />
            <div>
              <span class="cc-label">{t.labelPhone}</span>
              {
                phones.map((p) => (
                  <a href={p.href} dir="ltr" class="cc-value cc-link">
                    {p.display}
                  </a>
                ))
              }
            </div>
          </li>
          <li>
            <span class="cc-ic" aria-hidden="true" set:html={icons.mail} />
            <div>
              <span class="cc-label">{t.labelEmail}</span>
              <a href={`mailto:${EMAIL}`} dir="ltr" class="cc-value cc-link">
                {EMAIL}
              </a>
            </div>
          </li>
          <li>
            <span class="cc-ic" aria-hidden="true" set:html={icons.pin} />
            <div>
              <span class="cc-label">{t.labelStudio}</span>
              <span class="cc-value">{t.address}</span>
            </div>
          </li>
          <li>
            <span class="cc-ic" aria-hidden="true" set:html={icons.globe} />
            <div>
              <span class="cc-label">{t.labelWeb}</span>
              <a href="https://www.tallnest.com/" dir="ltr" class="cc-value cc-link">
                tallnest.com
              </a>
            </div>
          </li>
        </ul>

        <ul class="cc-social">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  set:html={s.svg}
                />
              </li>
            ))
          }
        </ul>

        <p class="cc-careers">
          <span class="cc-careers-h">{t.careersHeading}.</span>
          {t.careersLine}
        </p>
      </div>

      <!-- Message us — WhatsApp first, phone & email alongside -->
      <div class="cc-msg">
        <p class="cc-msg-eyebrow">Message us</p>
        <h3 class="cc-msg-h font-display text-balance">The quickest way to reach us is WhatsApp.</h3>
        <p class="cc-msg-sub">
          Send a message and the right person picks it up. We usually reply
          within a day or two.
        </p>

        <div class="cc-msg-ctas">
          <WhatsAppCTA theme="corporate-solid" intent="general" label="Send us a message" class="cc-msg-btn" />
          <WhatsAppCTA theme="corporate" intent="distributor" label="Distributor enquiry" class="cc-msg-btn" />
        </div>

        <div class="cc-alt">
          <p class="cc-alt-h">Prefer to call or email?</p>
          <a href={PHONE_TEL} class="cc-alt-link" dir="ltr">
            <span class="cc-alt-ic" aria-hidden="true" set:html={icons.phone} />
            <span><span class="cc-alt-k">Call</span> {PHONE_DISPLAY}</span>
          </a>
          <a href={`mailto:${EMAIL}`} class="cc-alt-link" dir="ltr">
            <span class="cc-alt-ic" aria-hidden="true" set:html={icons.mail} />
            <span><span class="cc-alt-k">Email</span> {EMAIL}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-shell {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    overflow: hidden;
    border-radius: 30px;
    box-shadow: var(--shadow-e3);
    background: #fff;
  }
  @media (max-width: 880px) {
    .contact-shell {
      grid-template-columns: 1fr;
    }
  }

  /* Invitation panel */
  .cc-red {
    position: relative;
    overflow: hidden;
    background: var(--color-red);
    color: #fff;
    padding: clamp(32px, 4vw, 52px);
    display: flex;
    flex-direction: column;
  }
  /* Soft radial highlight for depth — also the reduced-motion calm fallback. */
  .cc-red::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(255, 255, 255, 0.16), transparent 55%),
      radial-gradient(90% 80% at 0% 100%, rgba(0, 0, 0, 0.16), transparent 60%);
    pointer-events: none;
  }
  /* Soft drifting gradient blobs (no lines) behind the content. */
  .cc-blobs {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    transform: translate3d(0, 0, 0); /* cursor parallax applied via JS */
    will-change: transform;
  }
  .cc-blob {
    position: absolute;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.55;
    will-change: transform, opacity;
  }
  /* Tones around the base red (#93221E): lighter warmth + deeper shadow. */
  .cc-blob-1 {
    inset-inline-start: -12%;
    top: -10%;
    background: radial-gradient(circle, #c23a30, transparent 68%);
    animation: cc-drift-a 24s ease-in-out infinite;
  }
  .cc-blob-2 {
    inset-inline-end: -16%;
    top: 10%;
    background: radial-gradient(circle, #5e1411, transparent 70%);
    animation: cc-drift-b 30s ease-in-out infinite;
  }
  .cc-blob-3 {
    inset-inline-start: 18%;
    bottom: -22%;
    background: radial-gradient(circle, #b8392f, transparent 70%);
    animation: cc-drift-c 27s ease-in-out infinite;
  }
  .cc-blob-4 {
    inset-inline-end: 8%;
    bottom: 4%;
    width: 48%;
    background: radial-gradient(circle, #7a1c19, transparent 72%);
    animation: cc-drift-a 21s ease-in-out infinite reverse;
  }
  .cc-blobs.is-paused .cc-blob {
    animation-play-state: paused;
  }
  @keyframes cc-drift-a {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.5; }
    50% { transform: translate(7%, 6%) scale(1.12); opacity: 0.62; }
  }
  @keyframes cc-drift-b {
    0%, 100% { transform: translate(0, 0) scale(1.05); opacity: 0.5; }
    50% { transform: translate(-6%, 8%) scale(0.92); opacity: 0.6; }
  }
  @keyframes cc-drift-c {
    0%, 100% { transform: translate(0, 0) scale(0.95); opacity: 0.48; }
    50% { transform: translate(5%, -7%) scale(1.1); opacity: 0.6; }
  }
  .cc-red > *:not(.cc-blobs) {
    position: relative;
    z-index: 1;
  }
  /* Reduced motion: a single calm static gradient, no drift. */
  @media (prefers-reduced-motion: reduce) {
    .cc-blob {
      animation: none;
    }
    .cc-blob-2,
    .cc-blob-3,
    .cc-blob-4 {
      display: none;
    }
    .cc-blob-1 {
      inset: -20%;
      width: auto;
      opacity: 0.45;
    }
  }
  .cc-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 700;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 16px;
  }
  .cc-invite {
    margin: 16px 0 0;
    max-width: 34ch;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
  }
  .cc-list {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
  }
  .cc-list li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .cc-list li:first-child {
    border-top: 0;
  }
  .cc-ic {
    flex: none;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 2px;
  }
  .cc-label {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 4px;
  }
  .cc-value {
    display: block;
    color: #fff;
    text-decoration: none;
    font-size: 1.02rem;
  }
  .cc-link {
    position: relative;
    width: fit-content;
    transition: opacity 0.2s var(--ease-brand);
  }
  .cc-link::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-inline-end: 100%;
    bottom: -1px;
    height: 1.5px;
    background: #fff;
    transition: inset-inline-end 0.28s var(--ease-brand);
  }
  /* 44px tap area without changing layout or the underline (::after). */
  .cc-link::before {
    content: "";
    position: absolute;
    inset: -9px -4px;
  }
  .cc-link:hover {
    opacity: 0.9;
  }
  .cc-link:hover::after,
  .cc-link:focus-visible::after {
    inset-inline-end: 0;
  }
  .cc-social {
    list-style: none;
    display: flex;
    gap: 12px;
    margin: 28px 0 0;
    padding: 0;
  }
  .cc-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    transition:
      background 0.2s var(--ease-brand),
      color 0.2s var(--ease-brand),
      transform 0.2s var(--ease-brand);
  }
  .cc-social a:hover {
    background: #fff;
    color: var(--color-red);
    transform: translateY(-2px);
  }
  .cc-careers {
    margin: auto 0 0;
    padding-top: 28px;
    font-size: 0.85rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }
  .cc-careers-h {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
  }

  /* Message us panel */
  .cc-msg {
    padding: clamp(32px, 4vw, 52px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .cc-msg-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-red);
  }
  .cc-msg-h {
    margin-top: 14px;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .cc-msg-sub {
    margin-top: 12px;
    max-width: 44ch;
    line-height: 1.6;
    color: var(--color-gray);
  }
  .cc-msg-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
  .cc-msg-ctas :global(.cc-msg-btn) {
    flex: 1 1 220px;
  }
  .cc-alt {
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--color-hairline);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cc-alt-h {
    margin-bottom: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .cc-alt-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    width: fit-content;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.2s var(--ease-brand);
  }
  .cc-alt-link:hover {
    color: var(--color-red);
  }
  .cc-alt-ic {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--color-red);
    background: color-mix(in srgb, var(--color-red) 8%, transparent);
  }
  .cc-alt-k {
    display: inline-block;
    min-width: 3.2em;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gray);
  }

  @media (prefers-reduced-motion: reduce) {
    .cc-link::after,
    .cc-social a,
    .cc-alt-link {
      transition: none;
    }
  }
</style>

<script>
  // Soft gradient blobs: CSS handles the ambient drift; here we add a gentle
  // cursor parallax (the whole blob field eases toward the pointer) and pause
  // the drift when the panel is offscreen. Touch / reduced motion: ambient or
  // static only (no cursor follow).
  const blobs = document.querySelector<HTMLElement>(".cc-blobs");
  const panel = blobs?.closest<HTMLElement>(".cc-red") ?? null;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (blobs && panel && !reduce) {
    const RANGE = 22; // px the field drifts toward the cursor
    let cx = 0;
    let cy = 0;
    let tx = 0;
    let ty = 0;
    let raf = 0;
    let running = false;

    const tick = () => {
      cx += (tx - cx) * 0.06;
      cy += (ty - cy) * 0.06;
      blobs.style.transform = `translate3d(${cx.toFixed(2)}px, ${cy.toFixed(2)}px, 0)`;
      raf = requestAnimationFrame(tick);
    };
    const start = () => {
      if (!running) {
        running = true;
        blobs.classList.remove("is-paused");
        raf = requestAnimationFrame(tick);
      }
    };
    const stop = () => {
      running = false;
      blobs.classList.add("is-paused");
      cancelAnimationFrame(raf);
    };

    panel.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      const r = panel.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 2 * RANGE;
      ty = ((e.clientY - r.top) / r.height - 0.5) * 2 * RANGE;
    });
    panel.addEventListener("pointerleave", () => {
      tx = 0;
      ty = 0;
    });

    new IntersectionObserver(
      (entries) => entries.forEach((en) => (en.isIntersecting ? start() : stop())),
      { threshold: 0 },
    ).observe(panel);
  }
</script>
