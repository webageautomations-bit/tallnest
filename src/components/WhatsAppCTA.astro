---
// WhatsApp CTA. intent="distributor" (default) → WHATSAPP_DISTRIBUTOR,
// "Become a Jingo Distributor now"; intent="general" → WHATSAPP_GENERAL.
// theme="jingo": candy-pop WhatsApp-green pill (ink text — white on #25D366
// fails contrast). theme="corporate": restrained white pill, green glyph.
// theme="corporate-solid": the corporate primary (deep-red pill, white text).
import { WHATSAPP_DISTRIBUTOR, WHATSAPP_GENERAL, whatsappGlyph } from "../data/contact";

interface Props {
  theme: "jingo" | "corporate" | "corporate-solid";
  intent?: "distributor" | "general";
  label?: string;
  class?: string;
}
const { theme, intent = "distributor", label, class: cls } = Astro.props;
const href = intent === "general" ? WHATSAPP_GENERAL : WHATSAPP_DISTRIBUTOR;
const text = label ?? (intent === "general" ? "Message us on WhatsApp" : "Become a Jingo Distributor now");
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={["wa-cta", `wa-cta--${theme}`, cls]}
>
  <span class="wa-icon" set:html={whatsappGlyph} />
  <span>{text}</span>
  <span class="sr-only"> (opens WhatsApp in a new tab)</span>
</a>

<style>
  .wa-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 24px 0 18px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.15;
    text-align: start;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .wa-icon {
    display: inline-flex;
    width: 22px;
    height: 22px;
    flex: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Jingo — candy-pop */
  .wa-cta--jingo {
    background: #25d366;
    color: var(--jg-ink, #24121a);
    border: 2.5px solid var(--jg-ink, #24121a);
    box-shadow: 0 5px 0 var(--jg-ink, #24121a);
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.2s ease;
  }
  @media (hover: hover) {
    .wa-cta--jingo:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 0 var(--jg-ink, #24121a);
    }
  }
  .wa-cta--jingo:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 var(--jg-ink, #24121a);
  }

  /* Corporate — restrained */
  .wa-cta--corporate {
    min-height: 50px;
    background: #fff;
    color: var(--color-ink, #1e1b16);
    border: 1px solid var(--color-hairline, #e8e5df);
    box-shadow: 0 1px 2px rgba(30, 27, 22, 0.04), 0 10px 24px -16px rgba(30, 27, 22, 0.35);
    font-size: 0.95rem;
    transition:
      transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .wa-cta--corporate .wa-icon {
    color: #128c4a; /* WhatsApp green, darkened to read on white */
  }
  .wa-cta--corporate:hover {
    transform: translateY(-2px);
    border-color: #25d366;
    box-shadow: 0 1px 2px rgba(30, 27, 22, 0.04), 0 16px 30px -16px rgba(30, 27, 22, 0.45);
  }

  /* Corporate solid — matches the site's primary .btn (deep red) */
  .wa-cta--corporate-solid {
    min-height: 50px;
    background: var(--color-red, #93221e);
    color: #fff;
    font-size: 0.95rem;
    box-shadow: 0 10px 24px -10px rgba(147, 34, 30, 0.6);
    transition:
      transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .wa-cta--corporate-solid:hover {
    transform: translateY(-2px);
    background: var(--color-red-deep, #7a1c19);
    box-shadow: 0 16px 30px -12px rgba(147, 34, 30, 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-cta {
      transition: none;
    }
    .wa-cta:hover {
      transform: none;
    }
  }
</style>
