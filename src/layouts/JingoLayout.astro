---
// Jingo brand zone layout — separate from BaseLayout so Jingo gets its own
// header, footer and candy-pop theme. Reuses the shared plumbing (Tailwind
// base via global.css, Lenis smooth scroll, GSAP reveals, the FOUC guard) but
// none of the corporate chrome. Jingo tokens live in jingo.css, keyed to
// html[data-zone="jingo"], and are only bundled into pages using this layout.
import "../styles/global.css";
import "../styles/jingo.css";
import JingoHeader from "../components/jingo/JingoHeader.astro";
import JingoFooter from "../components/jingo/JingoFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Placeholder pages opt out of indexing until they're built. */
  noindex?: boolean;
}

const {
  title = "Jingo — Big flavour, small price, pure fun.",
  description =
    "Jingo is Pakistan's poppiest candy — candies, toffees, lollipops, liquid chocolates, bubblegums, bunties & nimkos at pocket-money prices. A Tall Nest brand.",
  image = "/jingo-carton.jpg",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const brandSchema = {
  "@context": "https://schema.org",
  "@type": "Brand",
  name: "Jingo",
  slogan: "Big flavour, small price, pure fun.",
  url: canonicalURL.toString(),
  logo: new URL("/Jingo-Logo-Red.png", Astro.site).toString(),
  description,
  parentOrganization: {
    "@type": "Organization",
    name: "Tall Nest Food & Beverages",
    url: Astro.site?.toString(),
  },
};
---

<!doctype html>
<html lang="en" dir="ltr" data-zone="jingo">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#E0202B" />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- FOUC guard — identical to BaseLayout: reveal targets are only
         pre-hidden when JS runs and motion is allowed, with a failsafe that
         un-hides everything if the reveal bundle never arrives. No JS or
         reduced motion: nothing is ever hidden. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        d.classList.add("reveal-active");
        setTimeout(function () {
          if (!window.__tnRevealReady) d.classList.remove("reveal-active");
        }, 3500);
      })();
    </script>

    <!-- Fonts: General Sans only (same Fontshare family as Tall Nest — no new
         webfont). Jingo's display type is General Sans 700, so preload the
         weights painted above the fold (400 body, 600 UI, 700 display) with the
         same preconnect + preload + display=swap guard as BaseLayout. -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://cdn.fontshare.com/wf/KWXO5X3YW4X7OLUMPO4X24HQJGJU7E2Q/VOWUQZS3YLP66ZHPTXAFSH6YACY4WJHT/NIQ54PVBBIWVK3PFSOIOUJSXIJ5WTNDP.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://cdn.fontshare.com/wf/K46YRH762FH3QJ25IQM3VAXAKCHEXXW4/ISLWQPUZHZF33LRIOTBMFOJL57GBGQ4B/3ZLMEXZEQPLTEPMHTQDAUXP5ZZXCZAEN.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://cdn.fontshare.com/wf/MFQT7HFGCR2L5ULQTW6YXYZXXHMPKLJ3/YWQ244D6TACUX5JBKATPOW5I5MGJ3G73/7YY3ZAAE3TRV2LANYOLXNHTPHLXVWTKH.woff2"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jingo by Tall Nest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(brandSchema)}
    />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="jg-skip">Skip to content</a>
    <JingoHeader />
    <main id="main">
      <slot />
    </main>
    <JingoFooter />

    <script>
      // Tell the inline-head failsafe the reveal bundle is running.
      (window as unknown as { __tnRevealReady?: boolean }).__tnRevealReady = true;
      import { initSmoothScroll } from "../scripts/smooth-scroll";
      import { initReveals, initHeadingReveals } from "../scripts/reveal";
      import { initCountUps } from "../scripts/count-up";
      initSmoothScroll();
      initReveals();
      initHeadingReveals();
      initCountUps();
    </script>
  </body>
</html>

<style>
  .jg-skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--jg-ink);
    color: var(--jg-cream);
    font-weight: 600;
    text-decoration: none;
  }
  .jg-skip:focus {
    top: 12px;
  }
</style>
