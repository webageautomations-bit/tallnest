---
// Jingo brand zone layout — separate from BaseLayout so Jingo gets its own
// header, footer and candy-pop theme. Reuses the shared plumbing (Tailwind
// base via global.css, Lenis smooth scroll, GSAP reveals, the FOUC guard) but
// none of the corporate chrome. Jingo tokens live in jingo.css, keyed to
// html[data-zone="jingo"], and are only bundled into pages using this layout.
import "../styles/global.css";
import "../styles/jingo.css";
import JingoHeader from "../components/jingo/JingoHeader.astro";
import JingoFooter from "../components/jingo/JingoFooter.astro";
import SocialRail from "../components/SocialRail.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import { jingoSocials } from "../data/socials";
import SEOHead from "../components/SEOHead.astro";
import { organizationNode, websiteNode, jingoBrandNode } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter image (root-relative), 1200×630. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  /** Extra page-level JSON-LD node(s), merged into the graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Opt a page out of indexing (none currently do). */
  noindex?: boolean;
  /** Scroll-reveal motion bundle (GSAP reveals + Lenis). Arcade game pages
   *  turn it off: they have no reveal content and run their own loop. */
  motion?: boolean;
  /** Floating WhatsApp button — off on game pages so it never sits over the
   *  play area / touch controls. */
  floatingWhatsApp?: boolean;
}

const {
  title = "Jingo — Candies, Toffees & Lollipops from Rs. 5 | Pakistan",
  description =
    "Jingo is a Pakistani confectionery brand from Tall Nest Group: 35+ candies, toffees, lollipops, liquid chocolates, bubblegums, bunties and nimkos at Rs. 5–50.",
  image,
  imageAlt = "Jingo — the candy brand from Tall Nest Group, with its nine candy mascots",
  type = "website",
  imageWidth,
  imageHeight,
  jsonLd,
  noindex = false,
  motion = true,
  floatingWhatsApp = true,
} = Astro.props;

// Jingo Brand + its parent Organization (Organization.brand → Jingo) + WebSite,
// plus any page-level nodes.
const DEFAULT_OG = "/og/jingo-og.jpg"; // 1200×630
const pageNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const graph = [jingoBrandNode, organizationNode, websiteNode, ...pageNodes];
---

<!doctype html>
<html lang="en" dir="ltr" data-zone="jingo" data-motion={motion ? undefined : "off"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- FOUC guard — identical to BaseLayout: reveal targets are only
         pre-hidden when JS runs and motion is allowed, with a failsafe that
         un-hides everything if the reveal bundle never arrives. No JS or
         reduced motion: nothing is ever hidden. -->
    {motion && (
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        d.classList.add("reveal-active");
        setTimeout(function () {
          if (!window.__tnRevealReady) d.classList.remove("reveal-active");
        }, 3500);
      })();
    </script>
    )}

    <!-- Fonts: General Sans only (same Fontshare family as Tall Nest — no new
         webfont). Jingo's display type is General Sans 700, so preload the
         weights painted above the fold (400 body, 600 UI, 700 display) with the
         same preconnect + preload + display=swap guard as BaseLayout. -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://cdn.fontshare.com/wf/KWXO5X3YW4X7OLUMPO4X24HQJGJU7E2Q/VOWUQZS3YLP66ZHPTXAFSH6YACY4WJHT/NIQ54PVBBIWVK3PFSOIOUJSXIJ5WTNDP.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://cdn.fontshare.com/wf/K46YRH762FH3QJ25IQM3VAXAKCHEXXW4/ISLWQPUZHZF33LRIOTBMFOJL57GBGQ4B/3ZLMEXZEQPLTEPMHTQDAUXP5ZZXCZAEN.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://cdn.fontshare.com/wf/MFQT7HFGCR2L5ULQTW6YXYZXXHMPKLJ3/YWQ244D6TACUX5JBKATPOW5I5MGJ3G73/7YY3ZAAE3TRV2LANYOLXNHTPHLXVWTKH.woff2"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap"
    />

    <SEOHead
      title={title}
      description={description}
      ogImage={image ?? DEFAULT_OG}
      ogImageWidth={image ? imageWidth : 1200}
      ogImageHeight={image ? imageHeight : 630}
      ogImageAlt={imageAlt}
      type={type}
      siteName="Jingo by Tall Nest Group"
      themeColor="#E0202B"
      robots={noindex ? "noindex,follow" : undefined}
      jsonLd={graph}
    />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="jg-skip">Skip to content</a>
    <JingoHeader />
    <main id="main">
      <slot />
    </main>
    <JingoFooter />
    <SocialRail links={jingoSocials} theme="jingo" />
    {floatingWhatsApp && <FloatingWhatsApp />}

    <script>
      // Tell the inline-head failsafe the page bundle is running.
      (window as unknown as { __tnRevealReady?: boolean }).__tnRevealReady = true;
      import { initAnchors } from "../scripts/anchors";
      import { initCountUps } from "../scripts/count-up";
      initAnchors();
      initCountUps();
      // Motion (GSAP + ScrollTrigger + SplitText reveals, Lenis on desktop)
      // loads only when motion is allowed — reduced-motion visitors never
      // download it. If the chunk fails, un-hide everything at once.
      if (
        document.documentElement.dataset.motion !== "off" &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        import("../scripts/motion")
          .then((m) => m.initMotion())
          .catch(() => document.documentElement.classList.remove("reveal-active"));
      }
    </script>
  </body>
</html>

<style>
  .jg-skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--jg-ink);
    color: var(--jg-cream);
    font-weight: 600;
    text-decoration: none;
  }
  .jg-skip:focus {
    top: 12px;
  }
</style>
