---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  flushFooter?: boolean;
}

const {
  title = "Tall Nest — A Pakistani Food & Beverage Company",
  description =
    "Tall Nest builds, markets, and distributes food & beverage brands for Pakistan. Our first brand is Jingo, with more in development.",
  image = "/og-default.jpg",
  flushFooter = false,
} = Astro.props;

// Canonical + absolute asset URLs (Astro.site is set in astro.config.mjs).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Tall Nest Food & Beverages",
  url: Astro.site?.toString(),
  logo: new URL("/tallnest-logo.png", Astro.site).toString(),
  description,
  address: {
    "@type": "PostalAddress",
    streetAddress: "DHA Phase 6",
    addressLocality: "Lahore",
    addressCountry: "PK",
  },
  telephone: "+92 317 827 6277",
  sameAs: [
    "https://www.facebook.com/tallnestgroup",
    "https://www.instagram.com/tallnestgroup",
    "https://www.linkedin.com/company/tallnestgroup",
  ],
  brand: {
    "@type": "Brand",
    name: "Jingo",
  },
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- FOUC-safe: only hide headings for the reveal if JS runs and motion is
         allowed. If JS fails or motion is reduced, headings stay fully visible. -->
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("reveal-active");
      }
    </script>

    <!-- Fonts: Sentient (display) + General Sans (body) via Fontshare -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=sentient@400,500,1&f[]=general-sans@400,500,600,700&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tall Nest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />

    <slot name="head" />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <Header t={t.nav} />
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true">
      <span class="scroll-progress-bar"></span>
    </div>
    <main id="main">
      <slot />
    </main>
    <Footer t={t} flush={flushFooter} />

    <script>
      import { initSmoothScroll } from "../scripts/smooth-scroll";
      import { initReveals, initHeadingReveals } from "../scripts/reveal";
      import { initScrollProgress } from "../scripts/scroll-progress";
      initSmoothScroll();
      initReveals();
      initHeadingReveals();
      initScrollProgress();
    </script>
  </body>
</html>
