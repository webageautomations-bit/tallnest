---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SocialRail from "../components/SocialRail.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import { corporateSocials } from "../data/socials";
import { t } from "../i18n/utils";
import SEOHead from "../components/SEOHead.astro";
import { organizationNode, websiteNode } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter image (root-relative), 1200×630. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  /** Extra page-level JSON-LD node(s), e.g. FAQPage — merged into the graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  flushFooter?: boolean;
}

const {
  title = "Tall Nest Group — Pakistani FMCG & Confectionery Brands",
  description =
    "Tall Nest Group is a Pakistani FMCG company building consumer brands. Its first, Jingo, offers 35+ confectionery products from Rs. 5 — distributors wanted.",
  image,
  imageAlt = "Tall Nest Group — Food & Beverages",
  type = "website",
  imageWidth,
  imageHeight,
  jsonLd,
  flushFooter = false,
} = Astro.props;

// Sitewide structured data (Organization + WebSite) + any page-level nodes.
const DEFAULT_OG = "/og/tallnest-og.jpg"; // 1200×630
const pageNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const graph = [organizationNode, websiteNode, ...pageNodes];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- FOUC-safe: only pre-hide reveal targets if JS runs and motion is
         allowed, so text is never shown in its final state before animating.
         Failsafe: if the reveal bundle never runs (load error), un-hide after a
         few seconds so text is never permanently stuck at opacity 0. If JS is
         disabled or motion is reduced, nothing is hidden at all. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        d.classList.add("reveal-active");
        setTimeout(function () {
          if (!window.__tnRevealReady) d.classList.remove("reveal-active");
        }, 3500);
      })();
    </script>

    <!-- Fonts: Sentient (display) + General Sans (body) via Fontshare.
         Static faces only (Sentient 400/500, General Sans 400–700 — all used;
         the variable Sentient face is not requested, so the preloaded static
         500 is the one that renders and nothing is downloaded twice).
         Preconnect BOTH the CSS host (api) and the font-file host (cdn), then
         preload the primary above-the-fold weights so they arrive before first
         paint and the swap is not visible. -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://cdn.fontshare.com/wf/XVVLA67EPQTZD7YHR3MQPW2IQXXDTGPX/IHGNDJMSP2Y53DG23KZTPBH753PUEUB2/RNUZPHMIVMPXFHVACRGCAJ32E6WUEDVU.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://cdn.fontshare.com/wf/MFQT7HFGCR2L5ULQTW6YXYZXXHMPKLJ3/YWQ244D6TACUX5JBKATPOW5I5MGJ3G73/7YY3ZAAE3TRV2LANYOLXNHTPHLXVWTKH.woff2"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://cdn.fontshare.com/wf/3RZHWSNONLLWJK3RLPEKUZOMM56GO4LJ/BPDRY7AHVI3MCDXXVXTQQ76H3UXA63S3/SB2OEB6IKZPRR6JT4GFJ2TFT6HBB6AZN.woff2"
    />
    <!-- One stylesheet per family: Fontshare's multi-family parser is
         order-sensitive (some combinations silently drop a family). -->
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=sentient@400,500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap"
    />

    <SEOHead
      title={title}
      description={description}
      ogImage={image ?? DEFAULT_OG}
      ogImageWidth={image ? imageWidth : 1200}
      ogImageHeight={image ? imageHeight : 630}
      ogImageAlt={imageAlt}
      type={type}
      siteName="Tall Nest Group"
      themeColor="#93221E"
      jsonLd={graph}
    />

    <slot name="head" />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <Header t={t.nav} />
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true">
      <span class="scroll-progress-bar"></span>
    </div>
    <main id="main">
      <slot />
    </main>
    <Footer t={t} flush={flushFooter} />
    <SocialRail links={corporateSocials} theme="corporate" />
    <FloatingWhatsApp />

    <script>
      // Signal the inline-head failsafe that the page bundle is running, so it
      // won't un-hide prematurely. If this bundle fails to load, the flag stays
      // unset and the failsafe reveals everything.
      (window as unknown as { __tnRevealReady?: boolean }).__tnRevealReady = true;
      import { initAnchors } from "../scripts/anchors";
      import { initScrollProgress } from "../scripts/scroll-progress";
      initAnchors();
      initScrollProgress();
      // Motion (GSAP + ScrollTrigger + SplitText reveals, Lenis on desktop)
      // loads only when motion is allowed — reduced-motion visitors never
      // download it. If the chunk fails, un-hide everything at once.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        import("../scripts/motion")
          .then((m) => m.initMotion())
          .catch(() => document.documentElement.classList.remove("reveal-active"));
      }
    </script>
  </body>
</html>
