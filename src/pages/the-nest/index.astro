---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import {
  getSortedPosts,
  readingTime,
  formatDate,
  coverGradient,
  postSlug,
  coverImage,
} from "../../lib/posts";
import { Image } from "astro:assets";

const posts = await getSortedPosts();
const [featured, ...rest] = posts;
const categories = [...new Set(posts.map((p) => p.data.category))];
const featuredHref = featured ? `/the-nest/${postSlug(featured)}` : "#";
---

<BaseLayout
  title="The Nest — FMCG & Confectionery Insights | Tall Nest Group"
  description="Notes on flavour, brands, distribution and the shelf — FMCG and confectionery brand-building insights for Pakistan from the Tall Nest Group team."
>
  <section class="section-y bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <p data-reveal class="eyebrow mb-5">The Nest</p>
      <h1
        data-reveal-heading
        class="max-w-3xl font-display text-[clamp(2.4rem,5vw,4rem)] font-medium leading-[1.04] tracking-[-0.02em] text-ink text-balance"
      >
        Notes on flavour, brands &amp; the shelf.
      </h1>
      <p data-reveal class="mt-6 max-w-[60ch] text-lg leading-relaxed text-gray">
        Practical thinking on building food &amp; beverage brands in Pakistan —
        pricing, packaging, distribution, and the craft of the everyday treat.
      </p>

      {
        featured && (
          <a data-reveal href={featuredHref} class="featured card">
            <div
              class="featured-cover"
              style={`background:${coverGradient(featured.data.category)}`}
            >
              {coverImage(featured.data.cover) && (
                <Image
                  class="featured-cover-img"
                  src={coverImage(featured.data.cover)!}
                  alt=""
                  widths={[480, 800, 1100]}
                  sizes="(min-width: 1024px) 640px, 100vw"
                  loading="lazy"
                />
              )}
              <span class="post-cat">{featured.data.category}</span>
            </div>
            <div class="featured-inner">
              <h2 class="featured-title font-display">{featured.data.title}</h2>
              <p class="featured-excerpt">{featured.data.excerpt}</p>
              <p class="featured-meta">
                {featured.data.author} · {formatDate(featured.data.publishDate)} ·{" "}
                {readingTime(featured)} min read
              </p>
            </div>
          </a>
        )
      }

      {
        categories.length > 1 && (
          <div class="filters" role="group" aria-label="Filter by category">
            <button type="button" class="chip-filter is-active" data-filter="all" aria-pressed="true">
              All
            </button>
            {categories.map((c) => (
              <button type="button" class="chip-filter" data-filter={c} aria-pressed="false">
                {c}
              </button>
            ))}
          </div>
        )
      }

      <ul data-reveal-group class="post-grid">
        {rest.map((post) => <PostCard post={post} />)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .featured {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    overflow: hidden;
    margin-top: clamp(40px, 5vw, 64px);
    text-decoration: none;
    color: inherit;
  }
  @media (max-width: 820px) {
    .featured {
      grid-template-columns: 1fr;
    }
  }
  .featured-cover {
    position: relative;
    min-height: 280px;
    display: flex;
    align-items: flex-end;
    padding: 18px;
    overflow: hidden;
  }
  .featured-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post-cat {
    position: relative;
    z-index: 1;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: rgba(0, 0, 0, 0.55); /* ≥ 4.5:1 for the white label over any photo */
    backdrop-filter: blur(4px);
    padding: 5px 10px;
    border-radius: 999px;
  }
  .featured-inner {
    padding: clamp(28px, 3.5vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .featured-title {
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }
  .featured-excerpt {
    margin: 16px 0 0;
    max-width: 48ch;
    line-height: 1.6;
    color: var(--color-gray);
  }
  .featured-meta {
    margin: 20px 0 0;
    font-size: 0.8rem;
    color: var(--color-gray);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: clamp(48px, 6vw, 72px) 0 28px;
  }
  .chip-filter {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-gray);
    background: #fff;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    transition:
      color 0.2s var(--ease-brand),
      border-color 0.2s var(--ease-brand),
      background 0.2s var(--ease-brand);
  }
  .chip-filter:hover {
    color: var(--color-red);
    border-color: color-mix(in srgb, var(--color-red) 40%, var(--color-hairline));
  }
  .chip-filter.is-active {
    color: #fff;
    background: var(--color-red);
    border-color: var(--color-red);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 980px) {
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
  .post-grid :global(.post-item.is-hidden) {
    display: none;
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".chip-filter");
  const cards = document.querySelectorAll<HTMLElement>(".post-grid .post-item");
  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      filters.forEach((b) => {
        b.classList.toggle("is-active", b === btn);
        b.setAttribute("aria-pressed", String(b === btn));
      });
      const f = btn.dataset.filter;
      cards.forEach((c) => {
        const show = f === "all" || c.dataset.category === f;
        c.classList.toggle("is-hidden", !show);
      });
    });
  });
</script>
