---
// /links — Tall Nest link-in-bio (reached mostly from LinkedIn / Facebook, a
// trade audience): the distributor enquiry leads as the primary action, then
// the navigation links. Every button carries a stable data-link-id for
// analytics. No JavaScript.
import { Image } from "astro:assets";
import LinksLayout from "../layouts/LinksLayout.astro";
import { WHATSAPP_DISTRIBUTOR, whatsappGlyph } from "../data/contact";
import { corporateSocials, socialIcons } from "../data/socials";
import tallNestLogo from "../assets/tallnest/tallnest-logo.png";

const social = (network: string) => corporateSocials.find((s) => s.network === network)!.url;
const icon = (body: string) =>
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${body}</svg>`;
const globe = icon(`<circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5c2.6 2.8 3.9 6 3.9 9.5S14.6 18.7 12 21.5M12 2.5C9.4 5.3 8.1 8.5 8.1 12s1.3 6.7 3.9 9.5"/>`);
const candy = icon(`<circle cx="12" cy="12" r="5"/><path d="M7.5 9.5 3 7l1 5-1 5 4.5-2.5M16.5 9.5 21 7l-1 5 1 5-4.5-2.5"/>`);
const out = icon(`<path d="M7 17 17 7M9 7h8v8"/>`);

interface LinkItem { id: string; label: string; href: string; icon: string; external: boolean }
// Same-site pages use root-relative URLs (= https://www.tallnest.com/… in
// production) and stay in-tab; other sites open in a new tab.
const links: LinkItem[] = [
  { id: "tallnest-website", label: "Tall Nest Website", href: "/", icon: globe, external: false },
  { id: "tallnest-linkedin", label: "LinkedIn", href: social("LinkedIn"), icon: socialIcons.linkedin, external: true },
  { id: "tallnest-instagram", label: "Instagram", href: social("Instagram"), icon: socialIcons.instagram, external: true },
  { id: "tallnest-facebook", label: "Facebook", href: social("Facebook"), icon: socialIcons.facebook, external: true },
  { id: "tallnest-jingo-website", label: "Jingo Website", href: "/jingo", icon: candy, external: false },
];
---

<LinksLayout
  zone="corporate"
  title="Tall Nest Group — Links"
  description="Tall Nest Group: become a Jingo distributor on WhatsApp, or visit our website, LinkedIn, Instagram and Facebook."
>
  <header class="tn-head">
    <Image src={tallNestLogo} alt="Tall Nest Group" width={190} densities={[1, 2]} loading="eager" fetchpriority="high" class="tn-logo" />
    <h1 class="tn-desc">Pakistani FMCG brands &middot; makers of Jingo</h1>
  </header>

  <nav aria-label="Tall Nest links">
    <a
      href={WHATSAPP_DISTRIBUTOR}
      target="_blank"
      rel="noopener noreferrer"
      class="tn-btn tn-btn--primary"
      data-link-id="tallnest-whatsapp-distributor"
    >
      <span class="tn-ico" set:html={whatsappGlyph} />
      <span class="tn-label">Become a Jingo Distributor</span>
      <span class="lk-sr">(opens WhatsApp)</span>
    </a>

    <ul class="tn-list" role="list">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="tn-btn"
              data-link-id={l.id}
              {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class="tn-ico" set:html={l.icon} />
              <span class="tn-label">{l.label}</span>
              {l.external && (
                <>
                  <span class="tn-out" set:html={out} />
                  <span class="lk-sr">(opens in a new tab)</span>
                </>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <p class="tn-foot">&copy; {new Date().getFullYear()} Tall Nest Group &middot; Lahore, Pakistan</p>
</LinksLayout>

<style>
  :global(.lk--corp) {
    background:
      radial-gradient(120% 60% at 50% 0%, #f7f6f4 0 40%, #ffffff 70%) no-repeat,
      #ffffff;
    color: #1e1b16;
  }
  .tn-head {
    display: grid;
    justify-items: center;
    gap: 14px;
    text-align: center;
    margin-bottom: 28px;
  }
  .tn-logo {
    width: 190px;
    height: auto;
  }
  .tn-desc {
    font-size: 0.98rem;
    font-weight: 500;
    color: #6b6358;
    letter-spacing: 0.01em;
  }
  .tn-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tn-btn {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 58px;
    padding: 12px 18px;
    border: 1px solid #e8e5df;
    border-radius: 16px;
    background: #ffffff;
    color: #1e1b16;
    font-size: 1.02rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(30, 27, 22, 0.05);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .tn-btn:active {
    background: #f7f6f4;
  }
  @media (hover: hover) {
    .tn-btn:hover {
      border-color: #93221e;
    }
  }
  .tn-ico {
    display: inline-flex;
    flex: none;
    width: 22px;
    height: 22px;
    color: #93221e;
  }
  .tn-label {
    flex: 1;
    min-width: 0;
  }
  .tn-out {
    display: inline-flex;
    flex: none;
    width: 18px;
    height: 18px;
    color: #6b6358;
  }
  /* Primary action — the distributor enquiry (accent fill, WhatsApp glyph). */
  .tn-btn--primary {
    min-height: 64px;
    margin-bottom: 22px;
    border-color: #7a1c19;
    background: #93221e;
    color: #ffffff;
    font-size: 1.08rem;
    box-shadow: 0 10px 24px -12px rgba(147, 34, 30, 0.65);
  }
  .tn-btn--primary .tn-ico {
    color: #ffffff;
    width: 24px;
    height: 24px;
  }
  .tn-btn--primary:active {
    background: #7a1c19;
  }
  @media (hover: hover) {
    .tn-btn--primary:hover {
      background: #7a1c19;
      border-color: #7a1c19;
    }
  }
  .tn-foot {
    margin-top: 28px;
    text-align: center;
    font-size: 0.8rem;
    color: #6b6358;
  }
  @media (prefers-reduced-motion: reduce) {
    .tn-btn {
      transition: none;
    }
  }
</style>
