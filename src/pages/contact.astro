---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../components/Contact.astro";
import { t } from "../i18n/utils";
---

<BaseLayout
  title="Contact Tall Nest Group — Lahore, Pakistan"
  description="Contact Tall Nest Group, DHA Phase 6, Lahore — for Jingo distribution, retail and partnership enquiries. Call or WhatsApp +92 317 827 6277."
>
  <!-- Intro -->
  <section class="bg-white pt-[clamp(5rem,10vw,8rem)] pb-2">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <p data-reveal class="eyebrow mb-6">Contact</p>
      <h1
        data-reveal-heading
        class="max-w-3xl font-display text-[clamp(2.4rem,5vw,4rem)] font-medium leading-[1.04] tracking-[-0.02em] text-ink text-balance"
      >
        Let's build something.
      </h1>
      <p data-reveal class="mt-6 max-w-[52ch] text-lg leading-relaxed text-gray">
        Whether you're a distributor, a retailer, or just curious — we'd love to
        hear from you.
      </p>
    </div>
  </section>

  <!-- Reused contact panel + form -->
  <Contact t={t.contact} />

  <!-- Head office map -->
  <section class="bg-white pb-[clamp(5rem,10vw,8rem)]">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <p data-reveal class="eyebrow mb-6">Head office</p>
      <div data-reveal class="map-card">
        <iframe
          title="Tall Nest — DHA Phase 6, Lahore"
          src="https://www.google.com/maps?q=DHA+Phase+6,+Lahore,+Pakistan&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .map-card {
    overflow: hidden;
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-e2);
    border: 1px solid var(--color-hairline);
  }
  .map-card iframe {
    display: block;
    width: 100%;
    height: clamp(300px, 42vw, 460px);
    border: 0;
  }
</style>
