---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import { categories, products, priceRange } from "../lib/jingo";
import { WHATSAPP_DISTRIBUTOR, PHONE_DISPLAY, PHONE_TEL, EMAIL } from "../data/contact";
import { SITE } from "../lib/schema";

// Facts used across the page (and the FAQPage schema) — derived from the
// product data so counts / prices can't drift from the catalogue.
const nCats = categories.length; // 7
const nProducts = products.length; // 35
const { min, max } = priceRange(); // Rs. 5 – Rs. 50
const pricePoints = [
  ...new Set(categories.flatMap((c) => (c.price.match(/\d+/g) ?? []).map(Number))),
].sort((a, b) => a - b); // 5, 10, 20, 50
const priceList = `Rs. ${pricePoints.slice(0, -1).join(", ")} and ${pricePoints.at(-1)}`;
const cat = (id: string) => categories.find((c) => c.id === id)!;

// Why-partner benefits — Lucide-style line icons (stroke uses currentColor).
const benefits = [
  {
    title: "Pocket-money pricing",
    line: "Rs. 5 to Rs. 50 — the impulse sweet-spot for kids.",
    icon: `<path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.2"/>`,
  },
  {
    title: "Full range, one brand",
    line: `${nCats} categories and ${nProducts}+ products to fill the counter.`,
    icon: `<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>`,
  },
  {
    title: "Fast-moving category",
    line: "Bright packs and mascots drive repeat pull.",
    icon: `<path d="M3 17l6-6 4 4 8-8"/><path d="M17 7h4v4"/>`,
  },
  {
    title: "Reliable supply",
    line: "Contract-manufactured for consistent quality and stock.",
    icon: `<path d="M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6z"/><path d="m9 12 2 2 4-4"/>`,
  },
  {
    title: "Territories available",
    line: "Exclusive areas open across Pakistan for committed partners.",
    icon: `<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20Z"/>`,
  },
];

// Commercials — headline stats + supply-chain flow.
const stats = [
  { n: `Rs. ${min}–${max}`, l: "Price points" },
  { n: String(nCats), l: "Categories" },
  { n: `${nProducts}+`, l: "Products" },
];
const flow = [
  {
    v: "50 pcs / box",
    k: "Inner pack",
    icon: `<path d="M21 8 12 3 3 8v8l9 5 9-5V8z"/><path d="m3 8 9 5 9-5M12 13v8"/>`,
  },
  {
    v: "36 box / carton",
    k: "Outer carton",
    icon: `<rect x="3" y="7" width="18" height="13" rx="1"/><path d="M3 7l3-4h12l3 4M12 7v13"/>`,
  },
  {
    v: "Across Pakistan",
    k: "Territories open",
    icon: `<path d="M1 3h15v13H1zM16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="18.5" cy="18.5" r="2"/>`,
  },
];

const steps = [
  { title: "Enquire", line: "Message us on WhatsApp — or call or email — with your company, city and the area you can cover." },
  { title: "Territory & coverage", line: "We discuss the territory and how you will cover it." },
  { title: "Agree terms", line: "Monthly commitment, exclusivity, advance payment and delivery." },
  { title: "Opening order", line: "You place your first order — typically fulfilled in 3–5 working days." },
];

const faqs = [
  {
    q: "How do I become a Jingo distributor?",
    a: "Message us on WhatsApp at +92 317 827 6277, or call or email us, with your company, city and the area you can cover. We then discuss the territory and how you will cover it, agree terms — the monthly commitment, exclusivity, advance payment and delivery — and you place your opening order.",
  },
  {
    q: "Which areas are available?",
    a: "Jingo is appointing distributors across Pakistan — in Punjab, Sindh, Khyber Pakhtunkhwa, Balochistan, Islamabad, Azad Kashmir and Gilgit-Baltistan. Territories are available in major markets such as Lahore, Karachi, Islamabad and Rawalpindi, Faisalabad, Multan, Peshawar and Quetta, and in smaller towns too: Jingo is built for B- and C-tier towns.",
  },
  { q: "What's the minimum order quantity?", a: "Sole distributorships carry a minimum commitment of Rs. 30 million per month. That reflects the scale of an exclusive territory — full coverage, consistent stock, and a partnership built for real volume." },
  { q: "Do you offer exclusive territories?", a: "Yes. We grant exclusive coverage where a distributor commits to fully covering the area and the order value justifies the territory. Protected territories reward the partners who invest in building the market." },
  { q: "What are the payment terms?", a: "Advance payment on all orders. As the relationship matures and a track record builds, terms can be revisited together." },
  { q: "What are typical lead times?", a: "Typically 3–5 working days. Timelines vary slightly by region and are coordinated with you in advance — once we commit a delivery window, we deliver on it." },
  {
    q: "What products does Jingo offer?",
    a: `Jingo covers ${nCats} categories and ${nProducts}+ products: candies (${cat("candies").flavourCount} flavours) and toffees (${cat("toffees").flavourCount}) at Rs. 5; Squizo liquid chocolates (${cat("squizo").flavourCount}), Twist lollipops (${cat("lollipops").flavourCount}) and Bublo bubblegums (${cat("bubblegums").flavourCount}) at Rs. 10; Choco Chums bunties at Rs. 5 and Rs. 10; and Mehfil nimkos (${cat("nimkos").flavourCount}) at Rs. 10, Rs. 20 and Rs. 50.`,
  },
  {
    q: "Who is Tall Nest Group?",
    a: "Tall Nest Group is a Pakistani food and beverage company based in Lahore that builds consumer brands. Jingo, its confectionery brand, is the first.",
  },
];

// FAQPage structured data — question/answer text is the visible copy above.
const faqSchema = {
  "@type": "FAQPage",
  "@id": `${SITE}/partners/#faq`,
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// "At a glance" — machine-extractable facts.
const glance = [
  { k: "Brand", v: "Jingo, by Tall Nest Group" },
  { k: "Categories", v: `${nCats} categories, ${nProducts}+ products — candies, toffees, liquid chocolates, lollipops, bubblegums, bunties and nimkos` },
  { k: "Price points", v: `${priceList} (Rs. ${min} to Rs. ${max})` },
  { k: "MOQ", v: "Rs. 30 million per month (sole distributorship)" },
  { k: "Territory", v: "Exclusive rights where full coverage is committed; territories available across Pakistan" },
  { k: "Payment", v: "Advance payment on all orders" },
  { k: "Lead time", v: "Typically 3–5 working days" },
];

// Territories available — regions and their major markets.
const regions = [
  { r: "Punjab", m: "Lahore, Faisalabad, Multan, Gujranwala, Sialkot, Sargodha and Bahawalpur" },
  { r: "Islamabad & Rawalpindi", m: "The twin cities — Islamabad Capital Territory and Rawalpindi" },
  { r: "Sindh", m: "Karachi, Hyderabad and Sukkur" },
  { r: "Khyber Pakhtunkhwa", m: "Peshawar, Mardan and Abbottabad" },
  { r: "Balochistan", m: "Quetta" },
  { r: "Azad Kashmir & Gilgit-Baltistan", m: "Open to distributors who can cover these regions" },
];

const arrowIcon = `<path d="M5 12h14M13 6l6 6-6 6"/>`;
---

<BaseLayout
  title="Become a Jingo Distributor in Pakistan | Tall Nest Group"
  description="Jingo confectionery is appointing distributors across Pakistan. Exclusive territories, 35+ products from Rs. 5. Enquire on WhatsApp."
  jsonLd={faqSchema}
>
  <!-- Intro: H1 + quotable summary + at a glance -->
  <section class="section-y bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <div class="intro-grid">
        <div>
          <p data-reveal class="eyebrow mb-6">For distributors</p>
          <h1
            data-reveal-heading
            class="max-w-3xl font-display text-[clamp(2.4rem,5vw,4rem)] font-medium leading-[1.04] tracking-[-0.02em] text-ink text-balance"
          >
            Become a Jingo Distributor in <em class="text-red">Pakistan</em>
          </h1>
          <p data-reveal class="summary">
            Tall Nest Group is a Pakistani food and beverage company based in
            Lahore. Its confectionery brand, Jingo, is appointing distributors
            across Pakistan, and territories are available now. The Jingo range
            covers {nCats} categories and {nProducts}+ products &mdash; candies,
            toffees, liquid chocolates, lollipops, bubblegums, bunties and nimkos
            &mdash; priced from Rs.&nbsp;{min} to Rs.&nbsp;{max}. Sole
            distributorships carry a minimum commitment of Rs.&nbsp;30 million per
            month, with exclusive territory rights where full coverage is
            committed. Orders are on advance payment and are typically fulfilled
            in 3&ndash;5 working days.
          </p>
          <div data-reveal class="intro-ctas">
            <WhatsAppCTA theme="corporate-solid" />
            <a href="#enquire" class="link-underline intro-alt">Or call or email us</a>
          </div>
        </div>

        <aside data-reveal class="glance panel" aria-labelledby="glance-h">
          <h2 id="glance-h" class="eyebrow">At a glance</h2>
          <dl class="glance-list">
            {
              glance.map((g) => (
                <div class="glance-row">
                  <dt>{g.k}</dt>
                  <dd>{g.v}</dd>
                </div>
              ))
            }
            <div class="glance-row">
              <dt>Contact</dt>
              <dd>
                WhatsApp{" "}
                <a href={WHATSAPP_DISTRIBUTOR} target="_blank" rel="noopener noreferrer" class="link-underline" dir="ltr">+92 317 827 6277</a>
                {" "}&middot;{" "}
                <a href="mailto:hello@tallnest.com" class="link-underline">hello@tallnest.com</a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- Why partner — bento grid -->
  <section class="section-y bg-paper">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <p data-reveal class="eyebrow mb-6">Why partner</p>
      <h2
        data-reveal-heading
        class="mb-10 max-w-2xl font-display text-[clamp(1.8rem,3.8vw,3rem)] font-medium leading-[1.05] tracking-[-0.01em] text-ink text-balance"
      >
        Built to <em class="text-red">move off shelves.</em>
      </h2>

      <ul data-reveal-group class="bento">
        {
          benefits.map((b, i) => (
            <li data-reveal-item class="pcard card">
              <span class="chip" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={b.icon}
                />
              </span>
              <div class="pnum font-display">{String(i + 1).padStart(2, "0")}</div>
              <h3 class="ptitle font-display">{b.title}</h3>
              <p class="pbody">{b.line}</p>
            </li>
          ))
        }
        <li data-reveal-item class="pcard pcard-cta group">
          <a href="#enquire" class="cta-link">
            <h3 class="font-display">Ready to distribute Jingo?</h3>
            <span class="go">
              Become a partner
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={arrowIcon}
              />
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Commercials — single premium panel -->
  <section class="section-y bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <p data-reveal class="eyebrow mb-6">The commercials</p>
      <h2
        data-reveal-heading
        class="mb-10 max-w-2xl font-display text-[clamp(1.8rem,3.5vw,2.8rem)] font-medium leading-[1.08] tracking-[-0.02em] text-ink text-balance"
      >
        Pack economics built for the counter.
      </h2>

      <div data-reveal class="spec-panel panel">
        <div class="toprow">
          {
            stats.map((s) => (
              <div class="bigstat">
                <div class="bigstat-n font-display">{s.n}</div>
                <div class="bigstat-l">{s.l}</div>
              </div>
            ))
          }
        </div>

        <hr class="midline" />

        <div class="flow-supply">
          {
            flow.map((f, i) => (
              <>
                {i > 0 && (
                  <span class="supply-arrow" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={arrowIcon}
                    />
                  </span>
                )}
                <div class="supply-step">
                  <span class="supply-ic" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={f.icon}
                    />
                  </span>
                  <div>
                    <div class="supply-v font-display">{f.v}</div>
                    <div class="supply-k">{f.k}</div>
                  </div>
                </div>
              </>
            ))
          }
        </div>

        <p class="foot">
          Pack ratios shown are for candies and toffees; case configurations
          vary by category &mdash; see the Jingo catalogue or ask us per SKU.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works — scroll-scrubbed timeline -->
  <section class="section-y bg-paper">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <p data-reveal class="eyebrow mb-5">How it works</p>
      <h2
        data-reveal-heading
        class="max-w-2xl font-display text-[clamp(1.8rem,3.5vw,2.8rem)] font-medium leading-[1.08] tracking-[-0.02em] text-ink text-balance"
      >
        Become a Jingo distributor in four steps.
      </h2>
      <div class="flow" data-flow>
        <span class="flow-line" aria-hidden="true"></span>
        <span class="flow-progress" aria-hidden="true"></span>
        <ol class="flow-grid">
          {
            steps.map((s, i) => (
              <li class="step" data-step>
                <span class="node" aria-hidden="true" />
                <span class="step-num font-display">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="mt-2 font-display text-xl font-medium text-ink">{s.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-gray">{s.line}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Territories available -->
  <section id="territories" class="section-y bg-white scroll-mt-24">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <p data-reveal class="eyebrow mb-6">Territories available</p>
      <h2
        data-reveal-heading
        class="max-w-3xl font-display text-[clamp(1.8rem,3.5vw,2.8rem)] font-medium leading-[1.08] tracking-[-0.02em] text-ink text-balance"
      >
        Appointing Jingo distributors across Pakistan.
      </h2>
      <p data-reveal class="terr-lede">
        We are inviting distributors in every province and region, and
        territories are available now. A territory is assigned when a
        distributor commits to covering it, so the markets below are open
        &mdash; not already taken.
      </p>

      <ul data-reveal-group class="regions">
        {
          regions.map((r) => (
            <li data-reveal-item class="region">
              <h3 class="region-name font-display">{r.r}</h3>
              <p class="region-markets">{r.m}</p>
            </li>
          ))
        }
      </ul>

      <p data-reveal class="terr-note">
        Jingo is priced for corner shops and general stores, so it is built for
        B- and C-tier towns as much as for the big cities. If your strength is a
        district, a cluster of smaller towns or a single city, that territory is
        open too.
      </p>
      <div data-reveal class="terr-cta">
        <WhatsAppCTA theme="corporate-solid" label="Ask about your territory" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-y bg-white">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <p data-reveal class="eyebrow mb-5">Questions</p>
      <h2
        data-reveal-heading
        class="mb-8 font-display text-[clamp(1.8rem,3.5vw,2.8rem)] font-medium leading-[1.08] tracking-[-0.02em] text-ink text-balance"
      >
        Jingo distributor FAQs
      </h2>
      <ul data-reveal-group class="faq">
        {
          faqs.map((f) => (
            <li data-reveal-item class="faq-item">
              <details>
                <summary>
                  <span>{f.q}</span>
                  <span class="faq-icon" aria-hidden="true" />
                </summary>
                <p>{f.a}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Enquire: WhatsApp first, phone & email alongside -->
  <section id="enquire" class="section-y bg-paper scroll-mt-24">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <p data-reveal class="eyebrow mb-5">Become a partner</p>
      <h2
        data-reveal-heading
        class="font-display text-[clamp(1.8rem,3.5vw,2.8rem)] font-medium leading-[1.08] tracking-[-0.02em] text-ink text-balance"
      >
        Tell us about your business.
      </h2>

      <p data-reveal class="enq-lede">
        Message us on WhatsApp with your company, city and the area you can
        cover &mdash; we&rsquo;ll take it from there.
      </p>

      <div data-reveal class="enq card">
        <WhatsAppCTA theme="corporate-solid" intent="distributor" class="enq-btn" />
        <p class="enq-or">Prefer to call or email?</p>
        <div class="enq-alt">
          <a href={PHONE_TEL} class="enq-link" dir="ltr">
            <span class="enq-ic" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2z"/></svg>
            </span>
            <span><span class="enq-k">Call</span>{PHONE_DISPLAY}</span>
          </a>
          <a href={`mailto:${EMAIL}`} class="enq-link" dir="ltr">
            <span class="enq-ic" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <span><span class="enq-k">Email</span>{EMAIL}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Why partner — bento ---- */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* Equal-height cells so every row's bottom edge aligns, longer copy simply
       grows the whole row uniformly. */
    align-items: stretch;
    grid-auto-rows: 1fr;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 900px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .bento {
      grid-template-columns: 1fr;
      /* Single column: let each card size to its own content. */
      grid-auto-rows: auto;
    }
  }
  .pcard {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px 26px 30px;
    transition:
      transform 0.35s var(--ease-brand),
      box-shadow 0.35s var(--ease-brand),
      border-color 0.35s var(--ease-brand);
  }
  /* Red top-accent grows from the reading-start edge on hover. */
  .pcard::before {
    content: "";
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    height: 3px;
    width: 0;
    background: var(--color-red);
    transition: width 0.4s var(--ease-brand);
    z-index: 1;
  }
  .pcard:hover::before {
    width: 100%;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    color: var(--color-red);
    background: color-mix(in srgb, var(--color-red) 9%, transparent);
    margin-bottom: 20px;
    transition:
      background 0.3s var(--ease-brand),
      color 0.3s var(--ease-brand);
  }
  .chip svg {
    width: 22px;
    height: 22px;
  }
  .pcard:hover .chip {
    background: var(--color-red);
    color: #fff;
  }
  .pnum {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-red);
    margin-bottom: 6px;
  }
  .ptitle {
    font-size: 1.32rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0 0 8px;
  }
  .pbody {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-gray);
    margin: 0;
  }

  /* CTA card — structurally identical to the white cards (same radius, shadow,
     border box, padding); only the colour differs. */
  .pcard-cta {
    background: linear-gradient(150deg, var(--color-red), var(--color-red-deep));
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-e2);
    color: #fff;
    padding: 0;
    transition:
      transform 0.35s var(--ease-brand),
      box-shadow 0.35s var(--ease-brand);
  }
  .pcard-cta:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-e3);
  }
  .pcard-cta::before {
    display: none;
  }
  .cta-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: 28px 26px 30px;
    color: #fff;
    text-decoration: none;
  }
  .pcard-cta h3 {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.1;
    color: #fff;
    margin: 0 0 14px;
  }
  .pcard-cta .go {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: #fff;
  }
