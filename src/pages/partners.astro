<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---- How it works: scroll-scrubbed timeline ---- */
  const flowEl = document.querySelector<HTMLElement>("[data-flow]");
  const progressEl = flowEl?.querySelector<HTMLElement>(".flow-progress");
  const stepEls = flowEl ? Array.from(flowEl.querySelectorAll<HTMLElement>("[data-step]")) : [];

  if (flowEl && progressEl && stepEls.length && !reduce) void runFlow(flowEl, progressEl);

  // GSAP + ScrollTrigger load only when motion is allowed (shared chunk).
  async function runFlow(flowEl: HTMLElement, progressEl: HTMLElement) {
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import("gsap"),
      import("gsap/ScrollTrigger"),
    ]);
    gsap.registerPlugin(ScrollTrigger);
    flowEl.classList.add("is-scrubbed");
    progressEl.style.setProperty("--draw", "0");

    const apply = (p: number) => {
      progressEl.style.setProperty("--draw", p.toFixed(4));
      stepEls.forEach((s, i) => {
        // Activate each step a touch before the line fully reaches it.
        const threshold = i / stepEls.length;
        s.classList.toggle("is-active", p >= threshold - 0.001);
      });
    };
    apply(0);

    ScrollTrigger.create({
      trigger: flowEl,
      start: "top 72%",
      end: "bottom 62%",
      scrub: 0.5,
      onUpdate: (self) => apply(self.progress),
      onRefresh: (self) => apply(self.progress),
    });
  }
</script>
