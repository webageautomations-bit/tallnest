---
// /jingo/arcade/chilli — "Chilli Chaska Challenge": keep the heat in the
// sweet spot. A needle sweeps a heat gauge; stop it inside the green zone.
// Each round the sweep speeds up and the zone narrows (its position is random
// every round). Points by accuracy, "Perfect!" dead-centre; a miss costs one
// of 3 lives. The star is the mascot of the Chilli Chaska candy, looked up
// from jingo-mascots.ts / jingo-products.ts (not hardcoded).
import ArcadeGameLayout from "../../../layouts/ArcadeGameLayout.astro";
import ShareResult from "../../../components/arcade/ShareResult.astro";
import { mascots } from "../../../data/jingo-mascots";
import { productById } from "../../../lib/jingo";
import { mascotSrc, packSrc, jsonForScript, gameUrl } from "../../../lib/arcade";
import { LIVES } from "../../../scripts/arcade/chilli-logic";

const CANDY_ID = "chilli-chaska"; // the candy this game is named after
const candy = productById(CANDY_ID);
const mascot = mascots.find((m) => m.relatedProductIds.includes(CANDY_ID));
if (!candy || !mascot) throw new Error(`Chilli Chaska Challenge: "${CANDY_ID}" product/mascot missing`);

const img = await mascotSrc(mascot.image, 480);
const pack = await packSrc(candy.id, 160, 72);
const url = gameUrl(Astro.site, "chilli");
const data = { url };
---

<ArcadeGameLayout
  slug="chilli"
  about="A timing game: a needle sweeps across a heat gauge. Stop it inside the green sweet spot. Every round gets faster."
  title="Chilli Chaska Challenge: Hit the Sweet Spot | Jingo by Tall Nest"
  description="Stop the sweeping needle inside the green zone. Every round it moves faster and the zone gets smaller. Three lives and one hot chilli. How far can you go?"
>
  <div class="cc" data-chilli>
    <!-- Intro -->
    <section class="ag-screen ag-panel ag-panel--accent cc-intro" data-screen="intro" aria-labelledby="cc-intro-h">
      <div class="cc-intro-row">
        <div>
          <h2 id="cc-intro-h" class="ag-display">Find the sweet spot.</h2>
          <p class="ag-sub">
            The needle sweeps across the heat gauge. <b>Stop it inside the green
            zone.</b> The closer to the centre, the more you score &mdash; dead
            centre is a <b>Perfect!</b> Every round it&rsquo;s faster and the zone
            is smaller. Miss and you lose a life.
          </p>
        </div>
        <img class="cc-intro-pack" src={pack.src} width={pack.w} height={pack.h} alt={`${candy.name} pack`} decoding="async" />
      </div>
      <p class="cc-controls">{LIVES} lives &middot; Tap, click or press <kbd>Space</kbd> to stop</p>
      <p class="cc-best" data-intro-best></p>
      <div class="ag-actions">
        <button type="button" class="jg-btn jg-btn--paper" data-start>
          Take the challenge <span class="jg-arrow" aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </section>

    <!-- Play -->
    <section class="ag-screen cc-play" data-screen="play" hidden aria-label="Chilli Chaska Challenge">
      <div class="cc-hud">
        <span class="ag-chip"><span class="ag-chip-label">Round</span> <b data-hud-round>1</b></span>
        <span class="ag-chip"><span class="ag-chip-label">Score</span> <b data-hud-score>0</b></span>
        <span class="ag-chip cc-lives" role="img" aria-label={`Lives: ${LIVES}`} data-hud-lives-chip>
          <span class="ag-chip-label">Lives</span>
          <span class="cc-hearts" data-hud-lives aria-hidden="true"></span>
        </span>
      </div>

      <div class="cc-stage" data-stage>
        <div class="cc-glow" aria-hidden="true"></div>
        <div class="cc-flames" aria-hidden="true">
          <span class="cc-flame"></span><span class="cc-flame"></span><span class="cc-flame"></span>
        </div>
        <div class="cc-mascot-wrap" style={`aspect-ratio:${img.w} / ${img.h}`}>
          <img class="cc-mascot" src={img.src} width={img.w} height={img.h} alt={`The Jingo ${mascot.label} character`} decoding="async" />
        </div>
        <p class="cc-verdict" data-verdict aria-hidden="true"></p>
      </div>

      <!-- Heat gauge: cool → hot, green sweet spot, sweeping needle -->
      <div class="cc-gauge" aria-hidden="true">
        <div class="cc-scale"><span>Mild</span><span>Hot</span></div>
        <div class="cc-track" data-track>
          <span class="cc-zone" data-sweet><span class="cc-zone-mid"></span></span>
          <span class="cc-needle" data-needle></span>
        </div>
      </div>

      <p class="cc-msg" data-msg>Stop the needle inside the green sweet spot.</p>

      <button type="button" class="cc-stop" data-stop>Stop!</button>
    </section>

    <!-- End -->
    <section class="ag-screen ag-panel cc-end" data-screen="end" hidden aria-labelledby="cc-end-h">
      <p class="cc-kicker">Burnt out</p>
      <h2 id="cc-end-h" class="ag-display" tabindex="-1" data-end-title>You survived 0 rounds.</h2>
      <p class="ag-new" data-end-new hidden>New best!</p>
      <dl class="ag-stats">
        <div class="ag-stat"><dt>Rounds</dt><dd data-end-rounds>0</dd></div>
        <div class="ag-stat"><dt>Score</dt><dd data-end-score>0</dd></div>
        <div class="ag-stat"><dt>Perfects</dt><dd data-end-perfects>0</dd></div>
        <div class="ag-stat"><dt>Best score</dt><dd data-end-best>0</dd></div>
      </dl>
      <div class="ag-actions">
        <button type="button" class="jg-btn" data-again>Play again</button>
      </div>
      <ShareResult message="I'm taking the Chilli Chaska Challenge in the Jingo Arcade. Your turn." url={url} />
    </section>

    <p class="ag-sr" aria-live="polite" data-live></p>
  </div>

  <script is:inline type="application/json" id="chilli-data" set:html={jsonForScript(data)} />
</ArcadeGameLayout>

<script>
  import { initChilli } from "../../../scripts/arcade/chilli";
  initChilli();
</script>

<style>
  .cc {
    max-width: 640px;
    margin-inline: auto;
    scroll-margin-top: calc(var(--jg-header-h) + 8px);
  }
  .cc-intro-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .cc-intro-pack {
    flex: none;
    width: clamp(70px, 20vw, 120px);
    height: auto;
    rotate: 6deg;
    filter: drop-shadow(0 6px 0 rgba(36, 18, 26, 0.3));
  }
  .cc-controls,
  .cc-best,
  .cc-kicker {
    margin-top: 16px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cc-best:empty {
    display: none;
  }
  .cc-controls kbd {
    padding: 2px 8px;
    border: 2px solid currentColor;
    border-radius: 8px;
    font-family: inherit;
  }

  /* HUD */
  .cc-hud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cc-hearts {
    font-size: 1rem;
    letter-spacing: 2px;
    color: var(--jg-red);
  }
  .cc-hearts :global(.off) {
    color: color-mix(in srgb, var(--jg-ink) 22%, transparent);
  }

  /* Stage — mascot reacts: calm (needle in the zone), happy/perfect on a hit,
     burning up on a miss. */
  .cc-stage {
    position: relative;
    height: clamp(190px, 30svh, 300px);
    margin-top: 10px;
    border: 2.5px solid var(--jg-ink);
    border-radius: var(--jg-radius);
    overflow: hidden;
    background: var(--jg-paper);
    box-shadow: 0 5px 0 var(--jg-ink);
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    transition: background-color 0.25s ease;
  }
  .cc-stage.is-calm {
    background: #dff6e6;
  }
  .cc-stage.is-burn {
    background: #ffc7b8;
  }
  .cc-stage.is-perfect {
    background: #fff1b8;
  }
  .cc-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 80%, rgba(255, 138, 31, 0.85), transparent 62%);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .cc-stage.is-burn .cc-glow {
    opacity: 1;
  }
  .cc-flames {
    position: absolute;
    bottom: -12px;
    left: 50%;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    translate: -50% 0;
    transform-origin: 50% 100%;
    transform: scaleY(0);
    opacity: 0;
    transition:
      transform 0.25s var(--jg-ease),
      opacity 0.2s ease;
  }
  .cc-stage.is-burn .cc-flames {
    transform: scaleY(1);
    opacity: 1;
  }
  .cc-flame {
    width: 64px;
    height: 130px;
    border-radius: 50% 50% 40% 40% / 70% 70% 30% 30%;
    background: linear-gradient(180deg, transparent, #ffc93c 30%, #ff8a1f 60%, #e0202b);
    animation: cc-flicker 0.3s ease-in-out infinite alternate;
  }
  .cc-flame:nth-child(2) {
    width: 80px;
    height: 170px;
    animation-delay: -0.15s;
  }
  .cc-flame:nth-child(3) {
    animation-delay: -0.08s;
  }
  @keyframes cc-flicker {
    to {
      transform: scaleY(0.82) skewX(4deg);
    }
  }
  /* Absolutely placed so its height resolves against the fixed-height stage;
     centred with `translate` so transform animations compose. */
  .cc-mascot-wrap {
    position: absolute;
    left: 50%;
    bottom: 5%;
    height: 80%;
    translate: -50% 0; /* aspect-ratio set inline from the render's real size */
  }
  .cc-mascot {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    transition: filter 0.25s ease;
  }
  .cc-stage.is-calm .cc-mascot {
    filter: drop-shadow(0 0 14px rgba(63, 191, 106, 0.9));
  }
  .cc-stage.is-burn .cc-mascot {
    filter: saturate(2) brightness(0.9) drop-shadow(0 0 18px rgba(224, 32, 43, 0.95));
  }
  .cc-stage.is-burn .cc-mascot-wrap {
    animation: cc-shake 0.09s linear 6;
  }
  .cc-stage.is-happy .cc-mascot-wrap,
  .cc-stage.is-perfect .cc-mascot-wrap {
    animation: cc-hop 0.45s var(--jg-ease);
  }
  @keyframes cc-shake {
    0%,
    100% {
      transform: translateX(-6px) rotate(-3deg);
    }
    50% {
      transform: translateX(6px) rotate(3deg);
    }
  }
  @keyframes cc-hop {
    40% {
      transform: translateY(-14px) rotate(-5deg) scale(1.04);
    }
  }
  .cc-verdict {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: clamp(1.6rem, 7vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--jg-ink);
    -webkit-text-stroke: 0;
    text-shadow: 0 3px 0 var(--jg-paper);
  }
  .cc-verdict[data-kind="perfect"] {
    color: var(--jg-red);
  }
  .cc-verdict[data-kind="miss"] {
    color: var(--jg-red-deep);
  }

  /* Gauge */
  .cc-gauge {
    margin-top: 14px;
    touch-action: manipulation;
  }
  .cc-scale {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--jg-ink-soft);
  }
  .cc-track {
    position: relative;
    height: 46px;
    margin-top: 6px;
    border: 3px solid var(--jg-ink);
    border-radius: 14px;
    background:
      repeating-linear-gradient(90deg, transparent 0 calc(10% - 2px), rgba(36, 18, 26, 0.18) calc(10% - 2px) 10%),
      linear-gradient(90deg, #ffe8a3, #ffb347 45%, #ff6a3d 75%, #e0202b);
    box-shadow: 0 4px 0 var(--jg-ink);
    overflow: hidden;
  }
  .cc-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    background: rgba(63, 191, 106, 0.88);
    border-inline: 3px solid #1f7a3c;
  }
  .cc-zone-mid {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 3px;
    margin-left: -1.5px;
    background: rgba(255, 255, 255, 0.95);
  }
  .cc-needle {
    position: absolute;
    top: -3px;
    bottom: -3px;
    left: -3px;
    width: 6px;
    border-radius: 3px;
    background: var(--jg-ink);
    box-shadow: 0 0 0 2px var(--jg-paper);
    will-change: transform;
  }
  .cc-msg {
    min-height: 1.5em;
    margin-top: 12px;
    font-weight: 600;
    text-align: center;
  }

  /* The one big button. */
  .cc-stop {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 88px;
    margin-top: 10px;
    border: 3px solid var(--jg-ink);
    border-radius: 28px;
    background: var(--jg-red);
    box-shadow: 0 7px 0 var(--jg-ink);
    color: var(--jg-white);
    font: inherit;
    font-size: clamp(1.4rem, 6vw, 1.8rem);
    font-weight: 700;
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .cc-stop:active {
    transform: translateY(5px);
    box-shadow: 0 2px 0 var(--jg-ink);
  }
  .cc-stop:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .cc-stop:focus-visible {
    border-radius: 28px;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Slower sweep is set in JS; here: no shake, flames or hops. */
    .cc-flames {
      display: none;
    }
    .cc-stage.is-burn .cc-mascot-wrap,
    .cc-stage.is-happy .cc-mascot-wrap,
    .cc-stage.is-perfect .cc-mascot-wrap {
      animation: none;
    }
    .cc-stage,
    .cc-glow,
    .cc-mascot {
      transition: none;
    }
    .cc-stop:active {
      transform: none;
    }
  }
</style>
