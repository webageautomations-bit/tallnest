---
// /jingo/arcade/delivery — "Delivery Dash": Frogger-style. A Jingo mascot
// carries a carton across the traffic to the shop. Grid movement (one step per
// input); arrows / WASD, swipe, or the on-screen D-pad. Traffic and the
// difficulty ramp live in src/scripts/arcade/delivery-world.ts (every round is
// verified crossable); rendering + input in delivery.ts.
// Reduced motion: a notice and a static opt-out first (same as Mascot Runner).
import ArcadeGameLayout from "../../../layouts/ArcadeGameLayout.astro";
import ShareResult from "../../../components/arcade/ShareResult.astro";
import { getImage } from "astro:assets";
import { mascots } from "../../../data/jingo-mascots";
import { games } from "../../../data/jingo-arcade";
import { products, packImage } from "../../../lib/jingo";
import { mascotSrc, packSrc, jsonForScript, gameUrl } from "../../../lib/arcade";
import { LIVES } from "../../../scripts/arcade/delivery-world";
import logoWhite from "../../../assets/jingo/jingo-logo-white.png";

const crew = await Promise.all(
  mascots.map(async (m) => ({ id: m.id, label: m.label, color: m.color, faces: m.faces, img: await mascotSrc(m.image, 160, 75) })),
);
const packs = await Promise.all(
  products.filter((p) => packImage(p.id)).map(async (p) => ({ id: p.id, img: await packSrc(p.id, 64, 70) })),
);
const logo = await getImage({ src: logoWhite, width: 200, format: "webp", quality: 80 });
const calmer = games.filter((g) => g.status === "live" && (g.slug === "quiz" || g.slug === "match"));
const url = gameUrl(Astro.site, "delivery");
const data = {
  crew,
  packs,
  url,
  logo: { src: logo.src, w: Number(logo.attributes.width), h: Number(logo.attributes.height) },
};
---

<ArcadeGameLayout
  slug="delivery"
  about="A road-crossing game: step across lanes of traffic to deliver Jingo stock to the shop without getting hit."
  title="Delivery Dash: Beat the Traffic | Jingo by Tall Nest"
  description="Carry the Jingo stock across busy lanes of rickshaws, bikes and trucks to the shop. Grab loose candies on the way. Every delivery, the traffic gets faster."
>
  <div class="dd" data-delivery>
    <!-- Reduced-motion notice -->
    <section class="ag-screen ag-panel" data-screen="rm" hidden aria-labelledby="dd-rm-h">
      <p class="dd-kicker">Heads up</p>
      <h2 id="dd-rm-h" class="dd-rm-h">This one moves a lot.</h2>
      <p class="ag-sub">
        Delivery Dash has traffic moving across the screen the whole time. Your
        device is set to reduce motion, so we&rsquo;ve kept it switched off.
      </p>
      {
        calmer.length > 0 && (
          <>
            <p class="dd-kicker dd-kicker--gap">Calmer games</p>
            <div class="ag-actions">
              {calmer.map((g) => (
                <a href={`/jingo/arcade/${g.slug}`} class="jg-btn jg-btn--sun">
                  {g.name}
                </a>
              ))}
            </div>
          </>
        )
      }
      <button type="button" class="dd-optin" data-optin>I understand &mdash; show Delivery Dash anyway</button>
    </section>

    <!-- Select -->
    <section class="ag-screen ag-panel ag-panel--accent" data-screen="select" hidden aria-labelledby="dd-select-h">
      <h2 id="dd-select-h" class="ag-display">Pick your driver&hellip; er, walker.</h2>
      <p class="ag-sub">
        Get the carton across the road to the shop &mdash; one step at a time.
        Swipe, use the arrows, or tap the pad. Grab loose candies for a bonus.
        {LIVES} lives.
      </p>
      <div class="dd-crew" role="radiogroup" aria-label="Characters">
        {
          crew.map((m, i) => (
            <button
              type="button"
              role="radio"
              class="dd-pick"
              data-pick={m.id}
              aria-checked={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              style={`--m:${m.color}`}
            >
              <img src={m.img.src} width={m.img.w} height={m.img.h} alt="" loading="lazy" decoding="async" />
              <span>{m.label}</span>
            </button>
          ))
        }
      </div>
      <p class="dd-best" data-select-best></p>
      <div class="ag-actions">
        <button type="button" class="jg-btn jg-btn--paper" data-go>
          <span>Deliver as <span data-go-name>{crew[0].label}</span></span> <span class="jg-arrow" aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </section>

    <!-- Play -->
    <section class="ag-screen dd-play" data-screen="play" hidden aria-label="Delivery Dash">
      <div class="dd-hud">
        <span class="ag-chip"><span class="ag-chip-label">Score</span> <b data-hud-score>0</b></span>
        <span class="ag-chip"><span class="ag-chip-label">Delivered</span> <b data-hud-deliveries>0</b></span>
        <span class="ag-chip"><span class="ag-chip-label">Round</span> <b data-hud-round>1</b></span>
        <span class="ag-chip dd-lives" role="img" aria-label={`Lives: ${LIVES}`} data-hud-lives-chip>
          <span class="ag-chip-label">Lives</span><span class="dd-hearts" data-hud-lives aria-hidden="true"></span>
        </span>
      </div>
      <div class="dd-stage" data-stage tabindex="0" role="application" aria-label="Delivery Dash game area. Arrow keys or W A S D to step, P to pause; swipe on touch screens." aria-describedby="ag-about">
        <div class="dd-frame">
          <canvas class="dd-canvas" data-canvas width="360" height="532" role="img" aria-label="Delivery Dash road. Visual only; deliveries, hits and the final score are announced."></canvas>
          <button type="button" class="dd-pause" data-pause aria-label="Pause">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1.5" fill="currentColor"/><rect x="14" y="4" width="4" height="16" rx="1.5" fill="currentColor"/></svg>
          </button>
        </div>
      </div>
      <!-- Optional D-pad (touch screens) — bottom-right for one-handed play -->
      <div class="dd-pad" data-pad>
        <p class="dd-pad-hint">Swipe on the road, or tap:</p>
        <div class="dd-dpad">
          <button type="button" class="dd-btn dd-btn--up" data-dir="up" aria-label="Step up">
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 15 7-7 7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="dd-btn dd-btn--left" data-dir="left" aria-label="Step left">
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="dd-btn dd-btn--right" data-dir="right" aria-label="Step right">
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="dd-btn dd-btn--down" data-dir="down" aria-label="Step down">
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 9 7 7 7-7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
      <p class="dd-help"><kbd>&uarr;</kbd><kbd>&darr;</kbd><kbd>&larr;</kbd><kbd>&rarr;</kbd> or <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> to step &middot; <kbd>P</kbd> pause</p>
    </section>

    <!-- End -->
    <section class="ag-screen ag-panel" data-screen="end" hidden aria-labelledby="dd-end-h">
      <p class="dd-kicker">Out of lives</p>
      <h2 id="dd-end-h" class="ag-display" tabindex="-1" data-end-title>Shop&rsquo;s closed.</h2>
      <p class="ag-new" data-end-new hidden>New best!</p>
      <dl class="ag-stats">
        <div class="ag-stat"><dt>Deliveries</dt><dd data-end-deliveries>0</dd></div>
        <div class="ag-stat"><dt>Candies</dt><dd data-end-candies>0</dd></div>
        <div class="ag-stat"><dt>Score</dt><dd data-end-score>0</dd></div>
        <div class="ag-stat"><dt>Best</dt><dd data-end-best>0</dd></div>
      </dl>
      <div class="ag-actions">
        <button type="button" class="jg-btn" data-again>Deliver again</button>
        <button type="button" class="jg-btn jg-btn--paper" data-change>Change character</button>
      </div>
      <ShareResult message="I'm doing Delivery Dash in the Jingo Arcade. Think you can beat the traffic?" url={url} />
    </section>

    <p class="ag-sr" aria-live="polite" data-live></p>
  </div>

  <script is:inline type="application/json" id="delivery-data" set:html={jsonForScript(data)} />
</ArcadeGameLayout>

<script>
  import { initDelivery } from "../../../scripts/arcade/delivery";
  initDelivery();
</script>

<style>
  .dd {
    max-width: 640px;
    margin-inline: auto;
    scroll-margin-top: calc(var(--jg-header-h) + 6px);
  }
  .dd kbd {
    display: inline-block;
    min-width: 1.6em;
    padding: 0 5px;
    margin-inline: 1px;
    border: 2px solid currentColor;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.85em;
    text-align: center;
  }
  .dd-kicker,
  .dd-best {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .dd-kicker--gap {
    margin-top: 22px;
  }
  .dd-best {
    margin-top: 16px;
  }
  .dd-best:empty {
    display: none;
  }
  .dd-rm-h {
    margin-top: 8px;
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .dd-optin {
    min-height: 44px;
    margin-top: 20px;
    padding: 0 4px;
    border: 0;
    background: none;
    color: var(--jg-ink);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  /* Select */
  .dd-crew {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 20px;
  }
  .dd-pick {
    display: grid;
    justify-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 10px 6px 8px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 18px;
    background: color-mix(in srgb, var(--m) 26%, var(--jg-paper));
    box-shadow: 0 3px 0 var(--jg-ink);
    color: var(--jg-ink);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.15;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* Fixed height, width from the image's own ratio — never stretched. */
  .dd-pick img {
    width: auto;
    height: clamp(56px, 15vw, 92px);
  }
  .dd-pick[aria-checked="true"] {
    background: var(--m);
    box-shadow: 0 0 0 3px var(--jg-paper), 0 0 0 6px var(--jg-ink);
  }
  .dd-pick[aria-checked="true"] span {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--jg-paper);
  }
  .dd-pick:focus-visible {
    border-radius: 18px;
  }

  /* HUD */
  .dd-hud {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }
  .dd-hud .ag-chip {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    min-height: 46px;
    padding: 4px 6px;
    border-radius: 16px;
  }
  .dd-hud .ag-chip-label {
    font-size: 0.6rem;
  }
  .dd-hearts {
    font-size: 1rem;
    letter-spacing: 2px;
    color: var(--jg-red);
  }
  .dd-hearts :global(.off) {
    color: color-mix(in srgb, var(--jg-ink) 22%, transparent);
  }

  /* Stage: portrait road, sized to fit the viewport height too */
  .dd-stage {
    position: relative;
    margin-top: 8px;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .dd-stage:focus-visible {
    outline: 3px solid var(--jg-ink);
    outline-offset: 3px;
    border-radius: 18px;
  }
  .dd-frame {
    position: relative;
    width: 100%;
    max-width: min(520px, calc((100svh - 260px) * 360 / 532));
    margin-inline: auto;
  }
  .dd-canvas {
    display: block;
    width: 100%;
    aspect-ratio: 360 / 532;
    height: auto;
    border: 3px solid var(--jg-ink);
    border-radius: 18px;
    background: #463c4f;
  }
  .dd-pause {
    position: absolute;
    top: 6px;
    right: 6px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.9);
    color: var(--jg-ink);
    cursor: pointer;
  }

  /* D-pad (touch screens) */
  .dd-pad {
    display: none;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
    touch-action: none;
  }
  .dd-pad-hint {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--jg-ink-soft);
    max-width: 10em;
  }
  .dd-dpad {
    display: grid;
    grid-template-columns: repeat(3, 56px);
    grid-template-rows: repeat(2, 56px);
    gap: 6px;
  }
  .dd-btn {
    display: grid;
    place-items: center;
    border: 3px solid var(--jg-ink);
    border-radius: 16px;
    background: var(--jg-paper);
    box-shadow: 0 3px 0 var(--jg-ink);
    color: var(--jg-ink);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .dd-btn.is-down {
    transform: translateY(2px);
    box-shadow: 0 1px 0 var(--jg-ink);
    background: var(--jg-sun);
  }
  .dd-btn--up {
    grid-column: 2;
    grid-row: 1;
    background: #3fbf6a;
  }
  .dd-btn--left {
    grid-column: 1;
    grid-row: 2;
  }
  .dd-btn--down {
    grid-column: 2;
    grid-row: 2;
  }
  .dd-btn--right {
    grid-column: 3;
    grid-row: 2;
  }
  .dd-help {
    margin-top: 10px;
    font-size: 0.85rem;
    color: var(--jg-ink-soft);
    text-align: center;
  }
  @media (hover: none) and (pointer: coarse) {
    .dd-pad {
      display: flex;
    }
    .dd-help {
      display: none;
    }
  }
</style>
