---
// /jingo/arcade/cup — "Mascot Cup": a head-soccer duel, player vs CPU,
// starring the crew from jingo-mascots.ts. Timed match: 90 seconds, most goals
// wins (draws possible). Vanilla Canvas; physics + CPU brain in
// src/scripts/arcade/cup-world.ts, rendering + input in cup.ts.
// Reduced motion: a notice and a static opt-out first (same as Mascot Runner).
import ArcadeGameLayout from "../../../layouts/ArcadeGameLayout.astro";
import ShareResult from "../../../components/arcade/ShareResult.astro";
import { mascots } from "../../../data/jingo-mascots";
import { games } from "../../../data/jingo-arcade";
import { getImage } from "astro:assets";
import { mascotSrc, jsonForScript, gameUrl } from "../../../lib/arcade";
import { MATCH_SECONDS } from "../../../scripts/arcade/cup-world";
import logoWhite from "../../../assets/jingo/jingo-logo-white.png";

const crew = await Promise.all(
  mascots.map(async (m) => ({
    id: m.id,
    label: m.label,
    color: m.color,
    textOn: m.textOn,
    faces: m.faces,
    img: await mascotSrc(m.image, 200, 75),
  })),
);
const logo = await getImage({ src: logoWhite, width: 240, format: "webp", quality: 80 });
const calmer = games.filter((g) => g.status === "live" && (g.slug === "quiz" || g.slug === "match"));
const url = gameUrl(Astro.site, "cup");
const data = {
  crew,
  url,
  logo: { src: logo.src, w: Number(logo.attributes.width), h: Number(logo.attributes.height) },
};
---

<ArcadeGameLayout
  slug="cup"
  title="Mascot Cup: Head-Soccer With the Jingo Crew | Jingo by Tall Nest"
  description="Pick a Jingo character and take on the computer in a 90-second head-soccer duel. Head it high, kick it flat, win the cup. Three difficulty levels, free."
>
  <div class="cu" data-cup>
    <!-- Reduced-motion notice -->
    <section class="ag-screen ag-panel cu-rm" data-screen="rm" hidden aria-labelledby="cu-rm-h">
      <p class="cu-kicker">Heads up</p>
      <h2 id="cu-rm-h" class="cu-rm-h">This one moves a lot.</h2>
      <p class="ag-sub">
        Mascot Cup is a fast game with a ball and players moving the whole time.
        Your device is set to reduce motion, so we&rsquo;ve kept it switched off.
      </p>
      {
        calmer.length > 0 && (
          <>
            <p class="cu-kicker cu-kicker--gap">Calmer games</p>
            <div class="ag-actions">
              {calmer.map((g) => (
                <a href={`/jingo/arcade/${g.slug}`} class="jg-btn jg-btn--sun">
                  {g.name}
                </a>
              ))}
            </div>
          </>
        )
      }
      <button type="button" class="cu-optin" data-optin>I understand &mdash; show Mascot Cup anyway</button>
    </section>

    <!-- Select -->
    <section class="ag-screen ag-panel ag-panel--accent cu-select" data-screen="select" hidden aria-labelledby="cu-select-h">
      <h2 id="cu-select-h" class="ag-display">Pick your player.</h2>
      <p class="ag-sub">
        {MATCH_SECONDS} seconds, most goals wins. Head the ball for a high arc,
        hit it with your feet for a fast, flat shot &mdash; and <b>kick</b> to blast it.
        Grab the power-ups that pop up on the pitch before your rival does.
      </p>
      <div class="cu-crew" role="radiogroup" aria-label="Characters">
        {
          crew.map((m, i) => (
            <button
              type="button"
              role="radio"
              class="cu-pick"
              data-pick={m.id}
              aria-checked={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              style={`--m:${m.color}`}
            >
              <img src={m.img.src} width={m.img.w} height={m.img.h} alt="" loading="lazy" decoding="async" />
              <span>{m.label}</span>
            </button>
          ))
        }
      </div>
      <p class="cu-kicker cu-kicker--gap" id="cu-level-l">Opponent</p>
      <div class="cu-levels" role="radiogroup" aria-labelledby="cu-level-l">
        <button type="button" role="radio" class="cu-level" data-level="easy" aria-checked="false" tabindex="-1">Easy</button>
        <button type="button" role="radio" class="cu-level" data-level="normal" aria-checked="true" tabindex="0">Normal</button>
        <button type="button" role="radio" class="cu-level" data-level="hard" aria-checked="false" tabindex="-1">Hard</button>
      </div>
      <p class="cu-record" data-select-record></p>
      <div class="ag-actions">
        <button type="button" class="jg-btn jg-btn--paper" data-go>
          <span>Kick off as <span data-go-name>{crew[0].label}</span></span> <span class="jg-arrow" aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </section>

    <!-- Play -->
    <section class="ag-screen cu-play" data-screen="play" hidden aria-label="Mascot Cup match">
      <div class="cu-board" aria-live="polite">
        <div class="cu-team" data-team="left">
          <img class="cu-face" data-face-left alt="" width="200" height="245" decoding="async" />
          <span class="cu-name" data-name-left>You</span>
          <b class="cu-score" data-score-left>0</b>
        </div>
        <div class="cu-clock"><span class="ag-sr">Time left</span><b data-clock>1:30</b></div>
        <div class="cu-team cu-team--r" data-team="right">
          <b class="cu-score" data-score-right>0</b>
          <span class="cu-name" data-name-right>CPU</span>
          <img class="cu-face" data-face-right alt="" width="200" height="245" decoding="async" />
        </div>
      </div>

      <div class="cu-fxrow" aria-live="polite">
        <div class="cu-fx" data-fx-left></div>
        <div class="cu-fx cu-fx--r" data-fx-right></div>
      </div>

      <div class="cu-stage" data-stage tabindex="0" aria-label="Pitch. Arrow keys or A and D to move, up, W or Space to jump, down or S to kick.">
        <canvas class="cu-canvas" data-canvas width="720" height="405"></canvas>
        <button type="button" class="cu-pause" data-pause aria-label="Pause">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1.5" fill="currentColor"/><rect x="14" y="4" width="4" height="16" rx="1.5" fill="currentColor"/></svg>
        </button>

        <!-- Touch controls (shown on touch screens) -->
        <div class="cu-pad" data-pad>
          <div class="cu-pad-group">
            <button type="button" class="cu-btn" data-hold="left" aria-label="Move left">
              <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="cu-btn" data-hold="right" aria-label="Move right">
              <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <div class="cu-pad-group">
            <button type="button" class="cu-btn cu-btn--kick" data-tap="kick">Kick</button>
            <button type="button" class="cu-btn cu-btn--jump" data-tap="jump">Jump</button>
          </div>
        </div>
      </div>
      <p class="cu-tip">Tip: turn your phone sideways for a bigger pitch.</p>
      <p class="cu-help">
        <kbd>&larr;</kbd><kbd>&rarr;</kbd> / <kbd>A</kbd><kbd>D</kbd> move &middot;
        <kbd>&uarr;</kbd> / <kbd>W</kbd> / <kbd>Space</kbd> jump &middot;
        <kbd>&darr;</kbd> / <kbd>S</kbd> kick &middot; <kbd>P</kbd> pause
      </p>
    </section>

    <!-- End -->
    <section class="ag-screen ag-panel cu-end" data-screen="end" hidden aria-labelledby="cu-end-h">
      <p class="cu-kicker" data-end-kicker>Full time</p>
      <h2 id="cu-end-h" class="ag-display" tabindex="-1" data-end-title>You win!</h2>
      <div class="cu-final" data-end-line></div>
      <p class="cu-record" data-end-record></p>
      <div class="ag-actions">
        <button type="button" class="jg-btn" data-again>Rematch</button>
        <button type="button" class="jg-btn jg-btn--paper" data-change>Change character</button>
      </div>
      <ShareResult message="I'm playing Mascot Cup in the Jingo Arcade. Your turn." url={url} />
    </section>

    <p class="ag-sr" aria-live="polite" data-live></p>
  </div>

  <script is:inline type="application/json" id="cup-data" set:html={jsonForScript(data)} />
</ArcadeGameLayout>

<script>
  import { initCup } from "../../../scripts/arcade/cup";
  initCup();
</script>

<style>
  .cu {
    max-width: 920px;
    margin-inline: auto;
    scroll-margin-top: calc(var(--jg-header-h) + 6px);
  }
  .cu kbd {
    display: inline-block;
    min-width: 1.6em;
    padding: 0 5px;
    margin-inline: 1px;
    border: 2px solid currentColor;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.85em;
    text-align: center;
  }
  .cu-kicker,
  .cu-record {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cu-kicker--gap {
    margin-top: 22px;
  }
  .cu-record {
    margin-top: 16px;
  }
  .cu-record:empty {
    display: none;
  }

  /* Reduced-motion notice */
  .cu-rm-h {
    margin-top: 8px;
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .cu-optin {
    min-height: 44px;
    margin-top: 20px;
    padding: 0 4px;
    border: 0;
    background: none;
    color: var(--jg-ink);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  /* Select */
  .cu-crew {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 20px;
  }
  .cu-pick {
    display: grid;
    justify-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 10px 6px 8px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 18px;
    background: color-mix(in srgb, var(--m) 26%, var(--jg-paper));
    box-shadow: 0 3px 0 var(--jg-ink);
    color: var(--jg-ink);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.15;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .cu-pick img {
    width: auto;
    height: clamp(56px, 15vw, 92px);
  }
  .cu-pick[aria-checked="true"] {
    background: var(--m);
    box-shadow: 0 0 0 3px var(--jg-paper), 0 0 0 6px var(--jg-ink);
  }
  .cu-pick[aria-checked="true"] span {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--jg-paper);
  }
  .cu-pick:focus-visible,
  .cu-level:focus-visible {
    border-radius: 18px;
  }
  .cu-levels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 8px;
    max-width: 420px;
  }
  .cu-level {
    min-height: 48px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 999px;
    background: var(--jg-paper);
    color: var(--jg-ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .cu-level[aria-checked="true"] {
    background: var(--jg-ink);
    color: var(--jg-paper);
  }

  /* Scoreboard */
  .cu-board {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 18px;
    background: var(--jg-ink);
    color: var(--jg-paper);
  }
  .cu-team {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding: 4px 10px 4px 4px;
    border-radius: 12px;
    background: var(--team, #444);
    color: var(--team-fg, #fff);
  }
  .cu-team--r {
    justify-content: flex-end;
    padding: 4px 4px 4px 10px;
  }
  .cu-face {
    flex: none;
    width: auto;
    height: 38px;
    filter: drop-shadow(0 2px 0 rgba(0, 0, 0, 0.3));
  }
  .cu-face--flip {
    transform: scaleX(-1);
  }
  .cu-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .cu-score {
    margin-left: auto;
    font-size: 1.6rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .cu-team--r .cu-score {
    margin-left: 0;
    margin-right: auto;
  }
  .cu-clock b {
    display: block;
    min-width: 3.2em;
    padding: 4px 8px;
    border-radius: 10px;
    background: var(--jg-paper);
    color: var(--jg-ink);
    font-size: 1.15rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* Active power-up effects per player, with seconds left */
  .cu-fxrow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    min-height: 30px;
    margin-top: 6px;
  }
  .cu-fx {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .cu-fx--r {
    justify-content: flex-end;
  }
  .cu-fx :global(.cu-fxchip) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 26px;
    padding: 2px 9px;
    border: 2px solid var(--jg-ink);
    border-radius: 999px;
    background: var(--fx);
    color: var(--fxfg);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .cu-fx :global(.cu-fxchip b) {
    font-variant-numeric: tabular-nums;
  }

  /* Stage — canvas sized to fit the viewport height as well as the width */
  .cu-stage {
    position: relative;
    margin-top: 8px;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .cu-stage:focus-visible {
    outline: 3px solid var(--jg-ink);
    outline-offset: 3px;
    border-radius: 18px;
  }
  .cu-canvas {
    display: block;
    width: 100%;
    max-width: calc((100svh - 250px) * 16 / 9);
    aspect-ratio: 16 / 9;
    height: auto;
    margin-inline: auto;
    border: 3px solid var(--jg-ink);
    border-radius: 18px;
    background: #bfe7ff;
  }
  .cu-pause {
    position: absolute;
    top: 8px;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.9);
    color: var(--jg-ink);
    cursor: pointer;
  }

  /* Touch pad: thumbs — move on the left, kick/jump on the right. */
  .cu-pad {
    display: none;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
    touch-action: none;
  }
  .cu-pad-group {
    display: flex;
    gap: 12px;
  }
  .cu-btn {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border: 3px solid var(--jg-ink);
    border-radius: 999px;
    background: var(--jg-paper);
    box-shadow: 0 4px 0 var(--jg-ink);
    color: var(--jg-ink);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .cu-btn.is-down {
    transform: translateY(3px);
    box-shadow: 0 1px 0 var(--jg-ink);
    background: var(--jg-sun);
  }
  .cu-btn--kick {
    background: var(--jg-red);
    color: var(--jg-white);
  }
  .cu-btn--jump {
    background: #3fbf6a;
    color: var(--jg-ink);
  }
  .cu-help {
    margin-top: 10px;
    font-size: 0.85rem;
    color: var(--jg-ink-soft);
    text-align: center;
  }
  .cu-tip {
    display: none;
    margin-top: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--jg-ink-soft);
    text-align: center;
  }
  @media (hover: none) and (pointer: coarse) {
    .cu-pad {
      display: flex;
    }
    .cu-help {
      display: none;
    }
  }
  @media (hover: none) and (pointer: coarse) and (orientation: portrait) {
    .cu-tip {
      display: block;
    }
  }
  /* Short landscape phones: pad floats over the bottom corners of the pitch. */
  @media (hover: none) and (pointer: coarse) and (orientation: landscape) and (max-height: 520px) {
    .cu-canvas {
      max-width: calc((100svh - 120px) * 16 / 9);
    }
    .cu-pad {
      position: absolute;
      left: 8px;
      right: 8px;
      bottom: 8px;
      margin: 0;
      pointer-events: none;
    }
    .cu-btn {
      width: 58px;
      height: 58px;
      opacity: 0.85;
      pointer-events: auto;
    }
  }

  /* End */
  .cu-final {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 18px;
    padding: 12px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 20px;
    background: var(--jg-white);
  }
  .cu-final :global(img) {
    width: auto;
    height: 64px;
  }
  .cu-final :global(.flip) {
    transform: scaleX(-1);
  }
  .cu-final :global(b) {
    font-size: clamp(2rem, 8vw, 2.8rem);
    font-variant-numeric: tabular-nums;
  }
  .cu-final :global(span) {
    font-weight: 700;
  }
</style>
