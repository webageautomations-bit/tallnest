---
// /jingo/mascots — "Meet the crew": the 9 candy mascots, one per Jingo candy.
// Characters come from src/data/jingo-mascots.ts; each one IS its candy (the
// mascot's name is the product name), so the panel heads with that name and
// the chip carries the candy's flavour + price from src/data/jingo-products.ts.
// Renders: src/assets/jingo/mascots/<image>.png.
//
// Motion layering (so GSAP reveals never fight CSS transforms):
//   .stage [data-reveal]  → GSAP entrance (inline transform)
//     .figure             → hover tilt / bounce, tap squish (CSS)
//       .bob              → idle float (CSS keyframes)
// Reduced motion: no float, no tilt — static characters.
import { Image } from "astro:assets";
import JingoLayout from "../../layouts/JingoLayout.astro";
import JingoStockCTA from "../../components/jingo/JingoStockCTA.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import { mascots } from "../../data/jingo-mascots";
import { products, mascotImage, productById, textOnColor } from "../../lib/jingo";

const crew = mascots.map((m, i) => {
  // Exactly one candy per mascot (enforced in jingo-mascots.ts).
  const p = productById(m.relatedProductIds[0])!;
  const candy = { ...p, textColor: textOnColor(p) };
  return {
    ...m,
    img: mascotImage(m.image),
    // What the character is, for its alt text: "Sour Imli Candy" → "sour imli".
    look: p.flavour.replace(/ (Flavoured|Candy)$/, "").toLowerCase(),
    candy,
    // Number badge sits on the mascot's own colour → its contrast-derived textOn.
    badgeText: m.textOn === "light" ? "var(--jg-white)" : "var(--jg-ink)",
    num: String(i + 1).padStart(2, "0"),
    // Desynchronised idle float.
    bob: `--dur:${(4.6 + (i % 4) * 0.55).toFixed(2)}s;--delay:${(-i * 0.7).toFixed(2)}s;--r:${i % 2 ? 2 : -2}deg`,
  };
});
const total = String(crew.length).padStart(2, "0");
const names = crew.map((m) => m.label);
const nameList = `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;
---

<JingoLayout
  title="Jingo Mascots — Meet the 9 Candy Characters"
  description={`Meet the Jingo crew: nine characters, one for each Jingo candy — ${nameList}.`}
>
  <!-- Hero ---------------------------------------------------------------->
  <section class="hero" aria-labelledby="crew-h1">
    <div class="hero-panel">
      <div class="hero-copy">
        <p data-reveal class="jg-eyebrow eb-paper">{crew.length} candy characters</p>
        <h1 id="crew-h1" data-reveal-heading data-reveal-now class="h1 text-balance">
          Meet the <span class="hl">crew.</span>
        </h1>
        <p data-reveal class="lede">
          The characters behind our {crew.length} candy flavours &mdash; say hi,
          then go find their packs.
        </p>
      </div>
    </div>
  </section>

  <!-- Showcase ------------------------------------------------------------>
  <div class="showcase">
    {
      crew.map((m, i) => (
        <section
          id={m.id}
          class="mascot jg-anchor"
          aria-labelledby={`${m.id}-h`}
          style={`--c:${m.color};--badge-t:${m.badgeText}`}
        >
          <div class="jg-wrap">
            <article class:list={["m-card jg-sticker", { flip: i % 2 === 1 }]}>
              <div class="stage" data-reveal>
                <span class="blob" aria-hidden="true" />
                <div class="figure">
                  <span class="bob" style={m.bob}>
                    {m.img && (
                      <Image
                        src={m.img}
                        alt={`${m.label} — the Jingo ${m.look} character`}
                        widths={[320, 480, 640, 880]}
                        sizes="(min-width: 960px) 380px, 62vw"
                        quality={72}
                        loading="lazy"
                        decoding="async"
                        class="m-img"
                      />
                    )}
                  </span>
                  <span class="ground" aria-hidden="true" style={m.bob} />
                </div>
              </div>

              <div class="copy">
                <span class="num" aria-hidden="true">
                  {m.num}<span class="num-of">/{total}</span>
                </span>
                <h2 id={`${m.id}-h`} data-reveal-heading class="name text-balance">
                  {m.label}
                </h2>
                <div data-reveal class="candy">
                  <a
                    href={`/jingo/flavours#${m.candy.categoryId}`}
                    class="chip"
                    style={`--pc:${m.candy.color};--pt:${m.candy.textColor}`}
                  >
                    {m.candy.flavour} &middot; {m.candy.price}
                    <span class="sr-only"> &mdash; see {m.label} in the flavours range</span>
                    <span class="chip-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            </article>
          </div>
        </section>
      ))
    }
  </div>

  <!-- Close -------------------------------------------------------------->
  <section class="close" aria-labelledby="close-h">
    <div class="jg-wrap">
      <div class="close-band jg-sticker">
        <h2 id="close-h" data-reveal-heading class="close-h text-balance">
          Every character has a flavour.
        </h2>
        <p data-reveal class="close-sub">
          Taste the whole crew &mdash; all {products.length} Jingo flavours in one place.
        </p>
        <div data-reveal class="close-ctas">
          <a href="/jingo/flavours" class="jg-btn jg-btn--sun">
            See all {products.length} flavours <span class="jg-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <WhatsAppCTA theme="jingo" />
        </div>
      </div>
      <a href="/jingo/arcade" class="arcade-card jg-sticker" data-reveal>
        <span class="arcade-kicker">Jingo Arcade</span>
        <span class="arcade-title">Play with the crew</span>
        <span class="arcade-sub">Quick games starring the Jingo characters &mdash; made for your phone.</span>
        <span class="arcade-go" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <JingoStockCTA />
</JingoLayout>

<style>
  /* --- Hero ------------------------------------------------------------- */
  .hero {
    padding: 10px clamp(8px, 1.6vw, 18px) 0;
  }
  .hero-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(44px, 8vw, 88px) clamp(18px, 5vw, 56px);
    background-color: var(--jg-bubble);
    background-image: radial-gradient(rgba(255, 255, 255, 0.45) 2px, transparent 2.5px);
    background-size: 26px 26px;
    border: 2.5px solid var(--jg-ink);
    border-radius: var(--jg-radius-lg);
    box-shadow: 0 8px 0 var(--jg-ink);
  }
  /* Keep hero content within the standard content width (as .jg-wrap). */
  .hero-copy {
    max-width: 1160px;
    margin-inline: auto;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .eb-paper {
    background: var(--jg-paper);
  }
  .h1 {
    margin-top: 18px;
    font-size: clamp(3rem, 11vw, 7rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.05em;
    color: var(--jg-ink);
  }
  .hl {
    color: var(--jg-red-deep); /* --jg-red on the bubble-pink panel was 2.97:1 */
  }
  .lede {
    margin-top: 16px;
    max-width: 46ch;
    font-size: clamp(1.02rem, 2.2vw, 1.2rem);
    line-height: 1.5;
    color: var(--jg-ink);
  }

  /* --- Idle float (shared) ---------------------------------------------- */
  .bob {
    display: block;
    animation: jg-bob var(--dur, 5s) ease-in-out var(--delay, 0s) infinite;
  }
  @keyframes mascot-ground {
    0%,
    100% {
      transform: translateX(-50%) scaleX(1);
      opacity: 0.22;
    }
    50% {
      transform: translateX(-50%) scaleX(0.78);
      opacity: 0.12;
    }
  }

  /* --- Showcase --------------------------------------------------------- */
  .showcase {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .mascot {
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .m-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(8px, 3vw, 40px);
    padding: clamp(20px, 4vw, 48px);
    background: color-mix(in srgb, var(--c) 18%, var(--jg-paper));
    border-radius: var(--jg-radius-lg);
  }
  @media (min-width: 900px) {
    .m-card {
      grid-template-columns: 1.05fr 1fr;
    }
    .m-card.flip .stage {
      order: 2;
    }
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(260px, 52vw, 460px);
  }
  .blob {
    position: absolute;
    width: min(86%, 400px);
    aspect-ratio: 1;
    border-radius: 46% 54% 52% 48% / 52% 46% 54% 48%;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--c) 45%, white), color-mix(in srgb, var(--c) 70%, var(--jg-paper)));
    border: 2.5px solid var(--jg-ink);
    box-shadow: 0 6px 0 var(--jg-ink);
    rotate: -6deg;
  }
  .flip .blob {
    rotate: 8deg;
  }
  .figure {
    position: relative;
    z-index: 1;
    width: min(76%, 380px);
    transition: transform 0.45s var(--jg-ease);
    -webkit-tap-highlight-color: transparent;
  }
  .figure :global(.m-img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 10px 0 rgba(36, 18, 26, 0.15));
  }
  .ground {
    position: absolute;
    left: 50%;
    bottom: -4%;
    width: 56%;
    height: 14px;
    border-radius: 50%;
    background: var(--jg-ink);
    opacity: 0.2;
    transform: translateX(-50%);
    animation: mascot-ground var(--dur, 5s) ease-in-out var(--delay, 0s) infinite;
    z-index: -1;
  }
  @media (hover: hover) {
    .m-card:hover .figure {
      transform: rotate(-7deg) scale(1.06) translateY(-8px);
    }
    .m-card.flip:hover .figure {
      transform: rotate(7deg) scale(1.06) translateY(-8px);
    }
  }
  .figure:active {
    transform: scale(0.95, 1.04);
    transition-duration: 0.15s;
  }

  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .num {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    padding: 8px 14px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 999px;
    background: var(--c);
    color: var(--badge-t);
    box-shadow: 0 3px 0 var(--jg-ink);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    rotate: -3deg;
  }
  .num-of {
    font-size: 0.75rem;
    opacity: 1;
  }
  .name {
    margin-top: 16px;
    font-size: clamp(2.8rem, 9vw, 5.6rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.05em;
    color: var(--jg-ink);
  }
  /* The candy's flavour + price, in its pack colour, linking to the range. */
  .candy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: 18px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 18px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 999px;
    background: var(--pc);
    color: var(--pt);
    box-shadow: 0 4px 0 var(--jg-ink);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.25s var(--jg-ease),
      box-shadow 0.2s ease;
  }
  .chip-arrow {
    font-size: 1.1em;
  }
  @media (hover: hover) {
    .chip:hover {
      transform: translateY(-3px) rotate(-2deg);
      box-shadow: 0 7px 0 var(--jg-ink);
    }
  }
  .chip:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 var(--jg-ink);
  }

  /* --- Close ------------------------------------------------------------ */
  .close {
    padding-block: clamp(1rem, 3vw, 2rem) clamp(2.5rem, 6vw, 4rem);
  }
  .close-band {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(28px, 6vw, 64px) clamp(20px, 5vw, 56px);
    background: var(--jg-sky);
    border-radius: var(--jg-radius-lg);
    box-shadow: 0 8px 0 var(--jg-ink);
  }
  .close-h {
    font-size: clamp(2rem, 6vw, 3.6rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--jg-ink);
  }
  .close-sub {
    margin-top: 12px;
    max-width: 44ch;
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.5;
    color: var(--jg-ink);
  }
  .close-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 22px;
  }

  /* Arcade link — a sticker card under the close band. */
  .arcade-card {
    position: relative;
    display: grid;
    gap: 4px;
    margin-top: 20px;
    padding: 20px 76px 20px 22px;
    background: var(--jg-sun);
    color: var(--jg-ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.25s var(--jg-ease),
      box-shadow 0.25s var(--jg-ease);
  }
  .arcade-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .arcade-title {
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .arcade-sub {
    color: var(--jg-ink-soft);
  }
  .arcade-go {
    position: absolute;
    right: 18px;
    top: 50%;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-top: -23px;
    border: 2.5px solid var(--jg-ink);
    border-radius: 999px;
    background: var(--jg-red);
    color: var(--jg-white);
    font-size: 1.3rem;
    font-weight: 700;
    transition: transform 0.25s var(--jg-ease);
  }
  .arcade-card:active {
    transform: translateY(3px);
    box-shadow: var(--jg-shadow-press);
  }
  @media (hover: hover) {
    .arcade-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--jg-shadow-lift);
    }
    .arcade-card:hover .arcade-go {
      transform: translateX(4px);
    }
  }

  /* --- Reduced motion: static crew -------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .bob,
    .ground {
      animation: none !important;
    }
    .bob {
      transform: none;
    }
    .figure,
    .chip,
    .arcade-card,
    .arcade-go {
      transition: none;
    }
    .m-card:hover .figure,
    .m-card.flip:hover .figure {
      transform: none;
    }
  }
</style>
