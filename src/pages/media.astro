---
// /media — Tall Nest media gallery: the Jingo distributor launch event.
// Photos: src/assets/tallnest/media/launch-NN.jpg (sips-reduced copies of the
// shortlisted originals); astro:assets emits responsive WebP for the uniform
// 3:2 grid and
// a 1024/1600px WebP pair for the lightbox.
//
// No-JS: every tile is a plain link to its large WebP, so photos stay
// viewable. With JS: a <dialog> lightbox (modal = background inert, Esc to
// close, ←/→ to move, swipe on touch, focus returned to the tile).
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/tallnest/media/launch-*.jpg",
  { eager: true },
);
const sources = Object.keys(files)
  .sort()
  .map((k) => files[k].default);
const total = sources.length;

const photos = await Promise.all(
  sources.map(async (src, i) => {
    const [md, lg] = await Promise.all([
      getImage({ src, width: 1024, format: "webp", quality: 78 }),
      getImage({ src, width: 1600, format: "webp", quality: 78 }),
    ]);
    return {
      src,
      n: i + 1,
      alt: `Jingo distributor launch event — photo ${i + 1} of ${total}`,
      full: lg.src,
      srcset: `${md.src} 1024w, ${lg.src} 1600w`,
    };
  }),
);
---

<BaseLayout
  title="Jingo Distributor Launch Photos | Tall Nest Group Media"
  description="Photos from the launch event where Tall Nest Group introduced Jingo, its confectionery brand, to its distribution partners."
  image="/og/media-og.jpg"
  imageWidth={1200}
  imageHeight={630}
  imageAlt="Tall Nest Group team at the Jingo distributor launch event"
  flushFooter
>
  <section class="section-y bg-white">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <p data-reveal class="eyebrow mb-5">Media</p>
      <h1
        data-reveal-heading
        class="max-w-3xl font-display text-[clamp(2.4rem,5vw,4rem)] font-medium leading-[1.04] tracking-[-0.02em] text-ink text-balance"
      >
        Jingo Distributor Launch
      </h1>
      <p data-reveal class="mt-6 max-w-[60ch] text-lg leading-relaxed text-gray">
        Moments from the launch event where Tall Nest introduced its first brand,
        Jingo, to its distribution partners.
      </p>
      <p data-reveal class="meta-caps mt-6 text-[0.68rem] text-gray">
        {total} photos
      </p>

      <ul class="gallery" data-gallery aria-label="Launch event photos">
        {
          photos.map((p) => (
            <li class="tile">
              <a
                href={p.full}
                class="tile-link"
                data-full={p.full}
                data-srcset={p.srcset}
                data-alt={p.alt}
                aria-label={`Open photo ${p.n} of ${total}`}
              >
                <Image
                  src={p.src}
                  alt={p.alt}
                  widths={[320, 480, 640, 800]}
                  sizes="(min-width: 1280px) 390px, (min-width: 1024px) 31vw, 48vw"
                  loading="lazy"
                  decoding="async"
                  quality={72}
                  class="tile-img"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Lightbox (enhancement; inert until opened) -->
  <dialog class="lb" data-lightbox data-lenis-prevent aria-label="Photo viewer">
    <div class="lb-inner">
      <p class="lb-count" aria-live="polite"><span data-lb-count></span></p>
      <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Close photo viewer">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
      <figure class="lb-figure">
        <img class="lb-img" data-lb-img alt="" sizes="(min-width: 1100px) 1600px, 100vw" />
      </figure>
      <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Previous photo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Next photo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </dialog>

  <!-- CTA — dark panel that flows into the dark footer (as on /about) -->
  <section class="cta-wrap bg-white px-3 sm:px-4 lg:px-6">
    <div class="media-cta mx-auto max-w-7xl">
      <div class="media-cta-inner">
        <h2
          data-reveal-heading
          class="mx-auto max-w-4xl font-display text-[clamp(2rem,4.5vw,3.2rem)] font-medium leading-[1.08] tracking-[-0.02em] text-white text-balance"
        >
          Bring Jingo to <em class="media-cta-em">your market.</em>
        </h2>
        <div class="media-cta-actions">
          <a href="/partners" class="cta-primary group">
            Partner with us
            <span class="cta-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a href="/contact" class="cta-ghost">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Gallery: a uniform grid of 3:2 tiles (the photos' own aspect) ------
     2 columns on phones/tablets, 3 on desktop. Every tile the same size. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: clamp(36px, 6vw, 56px) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .gallery {
      gap: 14px;
    }
  }
  @media (min-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
  }
  .tile {
    aspect-ratio: 3 / 2;
    min-width: 0;
  }
  .tile-link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-paper);
  }
  .tile-link :global(.tile-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s var(--ease-brand);
  }
  .tile-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(30, 27, 22, 0.06);
    transition: box-shadow 0.25s var(--ease-brand);
    pointer-events: none;
  }
  @media (hover: hover) {
    .tile-link:hover :global(.tile-img) {
      transform: scale(1.03);
    }
    .tile-link:hover::after {
      box-shadow: inset 0 0 0 2px var(--color-red);
    }
  }
  .tile-link:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 3px;
    border-radius: 14px;
  }

  /* --- Lightbox --------------------------------------------------------- */
  .lb {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(20, 18, 15, 0.94);
    color: #fff;
  }
  .lb::backdrop {
    background: rgba(20, 18, 15, 0.6);
  }
  .lb[open] {
    animation: lb-in 0.2s var(--ease-brand);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-inner {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 64px clamp(8px, 7vw, 96px) 56px;
  }
  .lb-figure {
    margin: 0;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  .lb-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    touch-action: pan-y;
    user-select: none;
  }
  .lb-count {
    position: absolute;
    top: 22px;
    left: 24px;
    margin: 0;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.75);
  }
  .lb-btn {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    cursor: pointer;
    transition:
      background-color 0.2s var(--ease-brand),
      border-color 0.2s var(--ease-brand);
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.5);
  }
  .lb-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .lb-close {
    top: 10px;
    right: 12px;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: clamp(6px, 2vw, 24px);
  }
  .lb-next {
    right: clamp(6px, 2vw, 24px);
  }
  @media (max-width: 639px) {
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 6px;
      transform: none;
    }
    .lb-prev {
      left: calc(50% - 56px);
    }
    .lb-next {
      right: calc(50% - 56px);
    }
  }

  /* --- CTA (mirrors /about) ---------------------------------------------- */
  .cta-wrap {
    padding-top: clamp(24px, 4vw, 48px);
  }
  .media-cta {
    position: relative;
    overflow: hidden;
    background: var(--color-ink);
    border-radius: 36px 36px 0 0;
  }
  .media-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 100% at 50% -10%, rgba(224, 32, 43, 0.18), transparent 60%),
      radial-gradient(55% 90% at 100% 110%, rgba(0, 0, 0, 0.35), transparent 65%);
    pointer-events: none;
  }
  .media-cta-inner {
    position: relative;
    padding: clamp(64px, 10vw, 104px) clamp(24px, 5vw, 72px);
    text-align: center;
  }
  .media-cta-em {
    font-style: italic;
    color: #ff6b66;
  }
  .media-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 30px;
  }
  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    background: var(--color-red);
    color: #fff;
    border-radius: var(--radius-pill);
    padding: 0 30px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.5);
    transition:
      transform 0.2s var(--ease-brand),
      background 0.2s var(--ease-brand);
  }
  .cta-primary:hover {
    transform: translateY(-2px);
    background: var(--color-red-deep);
  }
  .cta-primary:hover .cta-arrow {
    transform: translateX(4px);
  }
  .cta-arrow {
    transition: transform 0.2s var(--ease-brand);
  }
  .cta-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: #fff;
    border-radius: var(--radius-pill);
    padding: 0 28px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      background 0.2s var(--ease-brand),
      border-color 0.2s var(--ease-brand);
  }
  .cta-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-link :global(.tile-img),
    .tile-link::after,
    .lb-btn,
    .cta-primary,
    .cta-arrow,
    .cta-ghost {
      transition: none;
    }
    .tile-link:hover :global(.tile-img) {
      transform: none;
    }
    .lb[open] {
      animation: none;
    }
  }
</style>

<script>
  // Lightbox enhancement. Without JS the tiles simply link to the large image.
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-gallery] .tile-link"),
  );

  if (dialog && typeof dialog.showModal === "function" && links.length) {
    const img = dialog.querySelector<HTMLImageElement>("[data-lb-img]")!;
    const count = dialog.querySelector<HTMLElement>("[data-lb-count]")!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>("[data-lb-prev]")!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>("[data-lb-next]")!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>("[data-lb-close]")!;
    const total = links.length;
    let index = 0;
    let opener: HTMLElement | null = null;

    const preload = (i: number) => {
      const a = links[(i + total) % total];
      const p = new Image();
      p.sizes = img.sizes;
      p.srcset = a.dataset.srcset ?? "";
      p.src = a.dataset.full ?? a.href;
    };

    const show = (i: number) => {
      index = (i + total) % total;
      const a = links[index];
      img.removeAttribute("src");
      img.srcset = a.dataset.srcset ?? "";
      img.src = a.dataset.full ?? a.href;
      img.alt = a.dataset.alt ?? "";
      count.textContent = `${index + 1} / ${total}`;
      preload(index + 1);
      preload(index - 1);
    };

    const open = (i: number, from: HTMLElement) => {
      opener = from;
      show(i);
      dialog.showModal();
      document.documentElement.style.overflow = "hidden";
      closeBtn.focus();
    };

    const close = () => {
      if (dialog.open) dialog.close();
    };

    links.forEach((a, i) =>
      a.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // new-tab etc.
        e.preventDefault();
        open(i, a);
      }),
    );

    prevBtn.addEventListener("click", () => show(index - 1));
    nextBtn.addEventListener("click", () => show(index + 1));
    closeBtn.addEventListener("click", close);

    // Click on the dark surround (not the photo or buttons) closes.
    dialog.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.classList.contains("lb-inner") || t.classList.contains("lb-figure")) close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        show(index + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        show(index - 1);
      } else if (e.key === "Tab") {
        // Keep focus cycling within the viewer's controls.
        const f = [closeBtn, prevBtn, nextBtn];
        const at = f.indexOf(document.activeElement as HTMLButtonElement);
        e.preventDefault();
        f[(at + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
      }
      // Esc: native <dialog> cancel → "close" event below.
    });

    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
      img.removeAttribute("src");
      img.removeAttribute("srcset");
      (links[index] ?? opener)?.focus();
    });

    // Touch swipe.
    let x0: number | null = null;
    img.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") x0 = e.clientX;
    });
    img.addEventListener("pointerup", (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
